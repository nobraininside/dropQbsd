# ==========================================================
#  dropQbsd -- sign_filelist
#
#  Signs the current manifest of monitored files.
#
#  Reads /etc/dropQbsd/filelist, hashes every listed file in
#  the same order verify_integrity uses, and writes the detached
#  signature keys/dropQbsd_scripts.sha256.sig.
#
#  Why this exists: sign and verify MUST use the same filter and
#  the same order, or the signature will never match. Duplicating
#  the logic in INSTALL.md invites drift; this helper is the
#  single source of truth for both. Comments (#) and blank lines
#  are skipped, exactly as verify_integrity skips them -- trim
#  happens BEFORE the comment check, so an indented comment is
#  still skipped.
#
#  Use this after ANY change to a monitored file, or
#  verify_integrity will report an INTEGRITY VIOLATION. This is
#  expected behaviour, not a bug: the trust anchor is the key,
#  and the signature must be regenerated.
#
#  The private key must be available for this operation:
#    - encrypted on disk (/root/dropQbsd.sec): passphrase asked
#      at signing time; the cron job never needs it
#    - offline key: restore it, sign, then move it back offline
#      (see INSTALL.md)
#
#  Path: /opt/dropQbsd/admin/sign_filelist
#  Permissions: chmod 700, root:wheel
#  Requirements: signify(1), sha256(1):
#    - OpenBSD: both in base system
#    - FreeBSD: pkg install signify
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/admin/sign_filelist
#    OR
#    Sign
#
#  Exit codes:
#    0  signature written
#    1  setup or signing error
# ==========================================================


FILELIST="/etc/dropQbsd/filelist"
PRIVKEY="/root/dropQbsd.sec"
SIG="/opt/dropQbsd/keys/dropQbsd_scripts.sha256.sig"

stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# report: write one canonical line to the terminal.
# Format: "YYYY-MM-DD HH:MM:SS <message>" -- one space separator,
# identical to verify_integrity, enforce_drop and enforce_sync.
report() {
    printf '%s %s\n' "$(stamp)" "$1"
}

cd /opt/dropQbsd || { report "CANNOT cd /opt/dropQbsd"; exit 1; }

# --- Setup sanity ----------------------------------------------------
for f in "$FILELIST" "$PRIVKEY"; do
    if [ ! -r "$f" ]; then
        report "SETUP INCOMPLETE - missing $f"
        exit 1
    fi
done

TMP=$(mktemp /tmp/sign_filelist.XXXXXX) || exit 1
trap 'rm -f "$TMP" "$TMP.files"' EXIT INT TERM
FILE_ARGS="$TMP.files"

# --- Build the file list ---------------------------------------------
# Same filter and same order as verify_integrity. Do not change
# one without changing the other.
while IFS= read -r line; do
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$line" in
        ""|\#*) continue ;;
    esac

    if [ ! -f "$line" ]; then
        report "MISSING FILE $line"
        exit 1
    fi

    printf '%s\0' "$line" >> "$FILE_ARGS"
done < "$FILELIST"

if [ ! -s "$FILE_ARGS" ]; then
    report "FILELIST EMPTY - $FILELIST"
    exit 1
fi

# --- Hash and sign ---------------------------------------------------
# xargs -0 passes each path as a single argument, preserving spaces.
# The manifest is piped into signify via stdin (-m -).
xargs -0 sha256 < "$FILE_ARGS" \
    | signify -S -e -s "$PRIVKEY" -m - -x "$SIG"

RET=$?
if [ $RET -eq 0 ]; then
    report "OK - signature written"
else
    report "SIGNING FAILED (rc=$RET)"
fi

exit $RET
