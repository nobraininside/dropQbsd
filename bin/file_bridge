#!/bin/ksh
# ==========================================================
#  dropQbsd -- file_bridge
#
#  tmux-based 4-quadrant bridge. control_panel top-left,
#  vifm :only instances for userdoc, usermail, userweb.
#  Status bar + active pane border color follow domain.
#  qcp/qmv/qimport on ,c ,m ,i. Hidden files hidden.
#
#  Path: /opt/dropQbsd/bin/file_bridge
#  Permissions: chmod 755, root:wheel
#  Usage: file_bridge
#
#  Requirements: tmux, vifm, control_panel
# ==========================================================

SESSION="file_bridge"

# -- Teardown existing session ------------------------------

tmux kill-session -t "$SESSION" 2>/dev/null
sleep 0.3

# -- Quadrant 1: top-left, control_panel -------------------

tmux new-session -d -s "$SESSION" -n 'bridge' \
    "control_panel"

# -- Quadrant 2: top-right, userdoc -------------------------

tmux split-window -h -t "$SESSION:0" \
    "/opt/dropQbsd/bin/run_app userdoc vifm \
     '+only' \
     '+set nodotfiles' \
     '+cmap ,c qcp' \
     '+cmap ,m qmv' \
     '+cmap ,i qimport' \
     /home/userdoc"

# -- Quadrant 3: bottom-left, usermail ----------------------

tmux select-pane -t "$SESSION:0.0"
tmux split-window -v -t "$SESSION:0.0" \
    "/opt/dropQbsd/bin/run_app usermail vifm \
     '+only' \
     '+set nodotfiles' \
     '+cmap ,c qcp' \
     '+cmap ,m qmv' \
     '+cmap ,i qimport' \
     /home/usermail"

# -- Quadrant 4: bottom-right, userweb ----------------------

tmux select-pane -t "$SESSION:0.1"
tmux split-window -v -t "$SESSION:0.1" \
    "/opt/dropQbsd/bin/run_app userweb vifm \
     '+only' \
     '+set nodotfiles' \
     '+cmap ,c qcp' \
     '+cmap ,m qmv' \
     '+cmap ,i qimport' \
     /home/userweb"

# -- Even layout --------------------------------------------

tmux select-layout -t "$SESSION" tiled

# -- Pane titles --------------------------------------------

tmux select-pane -t "$SESSION:0.0" -T "control"
tmux select-pane -t "$SESSION:0.1" -T "userdoc"
tmux select-pane -t "$SESSION:0.2" -T "usermail"
tmux select-pane -t "$SESSION:0.3" -T "userweb"

# -- Status bar: domain name left, clock right --------------

tmux set-option -t "$SESSION" status-left ' #{pane_title} '
tmux set-option -t "$SESSION" status-right ' %Y-%m-%d %H:%M '
tmux set-option -t "$SESSION" window-status-format ''
tmux set-option -t "$SESSION" window-status-current-format ''

# -- Background watcher: updates status bar + active border --

WATCHER="/tmp/dropqbsd_watcher_$$"

cat > "$WATCHER" << 'WATCHER_EOF'
#!/bin/ksh
SESSION="file_bridge"
while tmux has-session -t "$SESSION" 2>/dev/null; do
    title=$(tmux display -pt "$SESSION:0" '#{pane_title}' 2>/dev/null)
    case "$title" in
        userdoc)  bg='#33CC33'; border='fg=#33CC33,bright' ;;
        usermail) bg='#BB66EE'; border='fg=#BB66EE,bright' ;;
        userweb)  bg='#3399FF'; border='fg=#3399FF,bright' ;;
        control)  bg='#222222'; border='fg=#888888,bright' ;;
        *)        bg='#444444'; border='fg=#FFFFFF' ;;
    esac
    tmux set-option -t "$SESSION" status-style "fg=white,bg=$bg" 2>/dev/null
    tmux set-option -t "$SESSION" pane-active-border-style "$border" 2>/dev/null
    tmux set-option -t "$SESSION" pane-border-style 'fg=#333333' 2>/dev/null
    sleep 0.5
done
rm -f "$WATCHER"
WATCHER_EOF
chmod +x "$WATCHER"

"$WATCHER" &

# -- Attach -------------------------------------------------

tmux attach-session -t "$SESSION"

# -- Cleanup -------------------------------------------------
kill %1 2>/dev/null
rm -f "$WATCHER"
