#!/bin/ksh
# ==========================================================
#  dropQbsd -- file_bridge
#
#  tmux-based 4-quadrant bridge. control_panel top-left,
#  nnn instances for userdoc (green), usermail (orchid),
#  userweb (blue) in the other three quadrants. NNN_COLORS
#  set per-domain via env. NNN_PLUG maps ;c ;m ;i directly.
#  Status bar + active pane border follow domain.
#
#  Alt+1/2/3/4: jump to quadrant.
#
#  Path: /opt/dropQbsd/bin/file_bridge
#  Permissions: chmod 755, root:wheel
#  Usage: file_bridge
#
#  Requirements: tmux, nnn, control_panel,
#                nnn plugins: c, m, i
# ==========================================================

SESSION="file_bridge"

# -- Teardown existing session ------------------------------

tmux kill-session -t "$SESSION" 2>/dev/null
sleep 0.3

# -- Pane 0: top-left, control_panel -----------------------

tmux new-session -d -s "$SESSION" -n 'bridge' \
    "control_panel"
tmux select-pane -t "$SESSION:0.0" -T "control"

# -- Pane 1: top-right, userdoc (green) ---------------------

tmux split-window -h -t "$SESSION:0.0" \
    "/opt/dropQbsd/bin/run_app userdoc env NNN_COLORS='2312' NNN_PLUG='c:qcp;m:qmv;i:qimport' nnn -H /home/userdoc"
tmux select-pane -t "$SESSION:0.1" -T "userdoc"

# -- Pane 2: bottom-left, usermail (orchid) -----------------

tmux split-window -v -t "$SESSION:0.1" \
    "/opt/dropQbsd/bin/run_app usermail env NNN_COLORS='5315' NNN_PLUG='c:qcp;m:qmv;i:qimport' nnn -H /home/usermail"
tmux select-pane -t "$SESSION:0.2" -T "usermail"

# -- Pane 3: bottom-right, userweb (blue) -------------------

tmux split-window -v -t "$SESSION:0.2" \
    "/opt/dropQbsd/bin/run_app userweb env NNN_COLORS='6316' NNN_PLUG='c:qcp;m:qmv;i:qimport' nnn -H /home/userweb"
tmux select-pane -t "$SESSION:0.3" -T "userweb"

# -- Even layout --------------------------------------------

tmux select-layout -t "$SESSION" tiled

# -- Status bar ---------------------------------------------

tmux set-option -t "$SESSION" status-right ' %Y-%m-%d %H:%M '
tmux set-option -t "$SESSION" window-status-format ''
tmux set-option -t "$SESSION" window-status-current-format ''

# -- Keyboard bindings: Alt+1/2/3/4 jump to quadrant -------

tmux bind-key -T root M-1 select-pane -t "$SESSION:0.0"
tmux bind-key -T root M-2 select-pane -t "$SESSION:0.1"
tmux bind-key -T root M-3 select-pane -t "$SESSION:0.2"
tmux bind-key -T root M-4 select-pane -t "$SESSION:0.3"
tmux bind-key -T root M-k kill-session -t "$SESSION"

# -- Background watcher --------------------------------------

WATCHER="/tmp/dropQbsd_watcher_$$"

cat > "$WATCHER" << 'WATCHER_EOF'
#!/bin/ksh
SESSION="file_bridge"
while tmux has-session -t "$SESSION" 2>/dev/null; do
    title=$(tmux list-panes -t "$SESSION" -F '#{?pane_active,#{pane_title},}' 2>/dev/null | grep -v '^$')
    case "$title" in
        userdoc)  bg='#33CC33'; border='fg=#33CC33,bright'; label=' userdoc ' ;;
        usermail) bg='#BB66EE'; border='fg=#BB66EE,bright'; label=' usermail ' ;;
        userweb)  bg='#3399FF'; border='fg=#3399FF,bright'; label=' userweb ' ;;
        control)  bg='#222222'; border='fg=#888888,bright'; label=' control ' ;;
        *)        bg='#444444'; border='fg=#FFFFFF';        label=' -- ' ;;
    esac
    tmux set-option -t "$SESSION" status-left "$label" 2>/dev/null
    tmux set-option -t "$SESSION" status-style "fg=white,bg=$bg" 2>/dev/null
    tmux set-option -t "$SESSION" pane-active-border-style "$border" 2>/dev/null
    tmux set-option -t "$SESSION" pane-border-style 'fg=#333333' 2>/dev/null
    sleep 0.3
done
rm -f "$WATCHER"
WATCHER_EOF
chmod +x "$WATCHER"

"$WATCHER" &

# -- Cleanup ------------------------------------------------

cleanup() {
    tmux kill-session -t "$SESSION" 2>/dev/null
    for user in userdoc usermail userweb; do
        pkill -9 -u "$user" -f nnn 2>/dev/null
    done
    kill %1 2>/dev/null
    rm -f "$WATCHER"
    exit 0
}
trap cleanup EXIT INT TERM HUP

# -- Attach -------------------------------------------------

tmux attach-session -t "$SESSION"

