#!/bin/ksh
# ==========================================================
#  dropQbsd -- indicator_xfce4
#
#  OSD popup on domain change. Shows a large centered
#  overlay on the active window when you switch domains.
#  Requires: dzen2, xdotool.
# 
#  Setup: /opt/dropQbsd/bin/indicator_xfce4 &
#
#  Path: /opt/dropQbsd/bin/indicator_xfce4
#  Permissions: chmod 755, root:wheel
# ==========================================================
last_owner=""
last_change=0
find_owner() {
    typeset wid="$1" pid owner uid wm_name wm_class

    wm_name=$(xprop -id "$wid" WM_NAME 2>/dev/null | cut -d'"' -f2)
    case "$wm_name" in
        "userweb"|"userweb "*|*" userweb")  echo "userweb"; return ;;
        "usermail"|"usermail "*|*" usermail") echo "usermail"; return ;;
        "userdoc"|"userdoc "*|*" userdoc")  echo "userdoc"; return ;;
        "root"|"root "*|*" root")           echo "root"; return ;;
    esac

    pid=$(xprop -id "$wid" _NET_WM_PID 2>/dev/null | awk '{print $NF}')
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
        uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
        owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ "$uid" = "0" ]; then echo "root"; return; fi
        case "$owner" in
            userweb|usermail|userdoc|user) echo "$owner"; return ;;
        esac
    fi

    wm_class=$(xprop -id "$wid" WM_CLASS 2>/dev/null | cut -d'"' -f2)
    case "$wm_class" in
        "xfe"|"Xfe"|"Thunar"|"thunar")
            for domain in userweb usermail userdoc; do
                if ps -U "$domain" -o comm= 2>/dev/null | grep -qi "$wm_class"; then
                    echo "$domain"; return
                fi
            done
            ;;
    esac

    echo "unknown"

while true; do
    raw=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
    active_id=$(echo "$raw" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' ')

    if [ -z "$active_id" ] || [ "$active_id" = "0x0" ]; then
        last_owner=""
        sleep 0.5
        continue
    fi

    owner=$(find_owner "$active_id")
    now=$(date +%s)

    # Popup only on domain change
    if [ "$owner" != "$last_owner" ] && [ -n "$owner" ] && [ "$owner" != "unknown" ]; then
        if [ $(( now - last_change )) -gt 1 ]; then
            case "$owner" in
                userweb)  fg_color="#3399FF" ;;
                usermail) fg_color="#BB66EE" ;;
                userdoc)  fg_color="#33CC33" ;;
                user)     fg_color="#FFFFFF" ;;
                root)     fg_color="#FF3333" ;;
                *)        fg_color="#666666" ;;
            esac

            geom=$(xdotool getwindowgeometry "$active_id" 2>/dev/null)
            if [ -n "$geom" ]; then
                wx=$(echo "$geom" | grep "Position" | awk '{print $2}' | cut -d',' -f1)
                wy=$(echo "$geom" | grep "Position" | awk '{print $2}' | cut -d',' -f2)
                ww=$(echo "$geom" | grep "Geometry" | awk '{print $2}' | cut -d'x' -f1)
                wh=$(echo "$geom" | grep "Geometry" | awk '{print $2}' | cut -d'x' -f2)
                px=$(( wx + ww/2 - 200 ))
                py=$(( wy + wh/2 - 40 ))
                [ "$px" -lt 0 ] && px=0
                [ "$py" -lt 0 ] && py=0
            else
                px=200; py=200
            fi

            echo "^bg(#000000) ^fg(${fg_color})  ${owner}  ^fg()^bg()" | \
                dzen2 -p 1 -x "$px" -y "$py" -h 60 -w 400 -ta c -fn '-*-*-*-r-*-*-34-*-*-*-*-*-*-*' &
            last_change=$now
        fi
        last_owner="$owner"
    fi

    sleep 0.5
done

}
