#!/bin/ksh
# ==========================================================
#  dropQbsd -- indicator_cwm
#
#  Domain indicator for minimal window managers: cwm, i3,
#  dwm, spectrwm, ratpoison, bspwm, herbstluftwm.
#  Sets the X11 root window name to the current domain via
#  xsetroot(1). Zero dependencies beyond base X11.
#
#  Setup: add to ~/.xsession before the WM line:
#    /opt/dropQbsd/bin/indicator_cwm &
#
#  Does NOT work with XFCE, KDE, GNOME — these ignore the
#  root window name. Use indicator_xfce4 instead.
#
#  Path: /opt/dropQbsd/bin/indicator_cwm
#  Permissions: chmod 755, root:wheel
# ==========================================================

while true; do
    raw=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
    active_id=$(echo "$raw" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' ')

    if [ -z "$active_id" ] || [ "$active_id" = "0x0" ]; then
        xsetroot -name "  dropQbsd: none"
        sleep 1
        continue
    fi

    pid=$(xprop -id "$active_id" _NET_WM_PID 2>/dev/null | awk '{print $NF}')
    [ -z "$pid" ] && { sleep 1; continue; }

    owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
    uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')

    # Root detection
    if [ "$uid" = "0" ]; then
        owner="root"
    else
        wm_name=$(xprop -id "$active_id" WM_NAME 2>/dev/null | cut -d'"' -f2)
        case "$wm_name" in
            *"[root@"*) owner="root" ;;
            "userweb"|"userweb "*|*" userweb")  owner="userweb" ;;
            "usermail"|"usermail "*|*" usermail") owner="usermail" ;;
            "userdoc"|"userdoc "*|*" userdoc")  owner="userdoc" ;;
        esac
    fi

    case "$owner" in
        userweb)  xsetroot -name "  WEB" ;;
        usermail) xsetroot -name "  MAIL" ;;
        userdoc)  xsetroot -name "  DOC" ;;
        user)     xsetroot -name "  CONDUCTOR" ;;
        root)     xsetroot -name "  ROOT" ;;
        *)        xsetroot -name "  ${owner}" ;;
    esac

    sleep 0.5
done
