#!/bin/ksh
# ==========================================================
#  dropQbsd -- indicator_cwm
#
#  Domain indicator for minimal window managers: cwm, i3,
#  dwm, spectrwm, ratpoison, bspwm, herbstluftwm, and any
#  WM that reads the X11 root window name for its status bar.
#
#  Sets the root window name to the current domain via
#  xsetroot(1). Zero dependencies beyond base X11.
#
#  Colors are not supported — root window name is plain text.
#  For color indicators, use indicator_xfce with XFCE/MATE
#  or pipe indicator_cwm into dzen2/lemonbar with color
#  formatting.
#
#  Setup:
#    Add to ~/.xsession or ~/.xinitrc:
#      /opt/dropQbsd/bin/indicator_cwm &
#
#    cwm and dwm pick it up automatically.
#    For i3, use as status_command in your i3status config.
#
#  Does NOT work with XFCE, KDE, GNOME — these ignore the
#  root window name. Use indicator_xfce instead.
#
#  Path: /opt/dropQbsd/bin/indicator_cwm
#  Permissions: chmod 755, root:wheel
# ==========================================================

while true; do
    active_id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')

    if [ -z "$active_id" ] || [ "$active_id" = "0x0" ]; then
        xsetroot -name "  dropQbsd: none"
        sleep 1
        continue
    fi

    pid=$(xprop -id "$active_id" _NET_WM_PID 2>/dev/null | awk '{print $NF}')
    [ -z "$pid" ] && { sleep 1; continue; }

    owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')

    case "$owner" in
        userweb)  xsetroot -name "  WEB" ;;
        usermail) xsetroot -name "  MAIL" ;;
        userdoc)  xsetroot -name "  DOC" ;;
        user)     xsetroot -name "  CONDUCTOR" ;;
        root)     xsetroot -name "  ROOT" ;;
        *)        xsetroot -name "  ${owner}" ;;
    esac

    sleep 0.5
done
