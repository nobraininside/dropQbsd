# ==========================================================
#  dropQbsd -- xterm_conductor
#
#  Opens a conductor xterm, optionally running a command.
#  Launched by the conductor through the wrapper.
#
#  Environment. The wrapper unsets HOME, ENV and any caller-supplied
#  PATH before this script runs, so nothing can be inherited: the script
#  DECLARES what it needs.
#    - PATH is set explicitly, and the script exits if xterm is not in
#      it. A missing binary must say so, not vanish and leave a silent
#      dead terminal.
#    - HOME is rebuilt from /etc/passwd using the real uid. It is never
#      taken from the environment.
#    - XAUTHORITY falls back to $HOME/.Xauthority when the session does
#      not export one: xenodm keeps the cookie only in the canonical
#      file.
#    - ENV is exported, so an interactive shell (-ls) loads the dropQbsd
#      ksh chain instead of whatever /etc/profile left behind.
#
#  The xterm is started with `nohup ... &`: the script returns at once
#  and the terminal outlives the shell that launched it.
#
#  Path: /opt/dropQbsd/sbin/xterm_conductor
#  Permissions: chmod 755, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_conductor [command [args...]]
#    OR
#    Xtconductor [command [args...]]
# ==========================================================

PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/X11R6/bin:/usr/local/bin:/usr/local/sbin
export PATH

command -v xterm >/dev/null 2>&1 || { echo "xterm_conductor: xterm not in PATH" >&2; exit 1; }

UID_R=$(id -ru)
HOME=$(awk -F: -v u="$UID_R" '$3 == u {print $6; exit}' /etc/passwd)
[ -z "$HOME" ] && { echo "xterm_conductor: cannot resolve home directory" >&2; exit 1; }
export HOME

[ -z "$XAUTHORITY" ] && export XAUTHORITY="$HOME/.Xauthority"

# Interactive shells inside this xterm load the dropQbsd chain.
export ENV=/etc/dropQbsd/kshrc

if [ $# -gt 0 ]; then
    nohup xterm -T "conductor" -bg black -fg white -fa monospace -fs 12 \
        -e "$@" </dev/null >/dev/null 2>&1 &
else
    nohup xterm -T "conductor" -bg black -fg white -fa monospace -fs 12 \
        -ls </dev/null >/dev/null 2>&1 &
fi

