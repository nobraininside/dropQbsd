# ==========================================================
#  dropQbsd -- xterm_usermail
#
#  Opens an xterm as usermail with the document domain
#  color scheme (darkorchid3 background).
#  Optionally accepts a command to run instead of an
#  interactive shell.
#
#  Path: /opt/dropQbsd/sbin/xterm_usermail
#  Permissions: chmod 755, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_usermail
#    OR
#    Xusermail
# ==========================================================

if [ $# -gt 0 ]; then
    CMD="$*"
    nohup /opt/dropQbsd/bin/run_app usermail xterm \
        -T "usermail" \
        -bg darkorchid3 -fg white \
        -fa monospace -fs 12 \
        -e "ksh -c '. /etc/dropQbsd/kshrc; exec $CMD'" \
        </dev/null >/dev/null 2>&1 &
else
    nohup /opt/dropQbsd/bin/run_app usermail xterm \
        -T "usermail" \
        -bg darkorchid3 -fg white \
        -fa monospace -fs 12 \
        -e "ksh -c '. /etc/dropQbsd/kshrc; exec ksh -l'" \
        </dev/null >/dev/null 2>&1 &
fi
