# ==========================================================
#  dropQbsd -- qinspect
#
#  Inspect a file in the drop zone WITHOUT importing it.
#
#  Safe by construction: it reads metadata, type, hash and
#  (for text) a truncated preview; for archives it lists the
#  contents. It NEVER executes, extracts, or opens the file
#  in an application that could run code.
#
#  It gives two verdicts: CONTENT (LOW/MEDIUM/HIGH, based on type and
#  contents) and TRANSIT (OK/WARN/BLOCK, from enforce_drop's rules:
#  mtime, GID, mode). The final verdict is IMPORT / IMPORT WITH CAUTION
#  / DO NOT IMPORT.
#
#  Exit code: 0 = import, 1 = caution, 2 = do not import.
#
#  Path: /opt/dropQbsd/sbin/qinspect
#  Permissions: chmod 755, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qinspect <file>
#    OR
#    Qinspect <file>
#
#  The file may be a bare name (looked up in /home/drop, like
#  qcp/qmv/qimport) or a path inside the drop zone
#  (/home/drop/...). Nothing outside the drop zone is inspected.
#
#  Exit code: 0 = LOW, 1 = MEDIUM, 2 = HIGH (scriptable).
# ==========================================================

set -u

DROP_ROOT="/home/drop"

[ $# -eq 1 ] || { echo "Usage: Qinspect <file>" >&2; exit 1; }
FILE="$1"

# --- Resolve the path. A bare name is looked up in the drop zone root;
#     a path must be inside the drop zone. No readlink -f (not available
#     on OpenBSD): plain path logic.
case "$FILE" in
    /*)
        ABSFILE="$FILE"
        case "$ABSFILE" in
            "$DROP_ROOT"/*) : ;;
            *)
                echo "ERROR: file is outside the drop zone: $ABSFILE" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        ABSFILE="$DROP_ROOT/$FILE"
        ;;
esac

[ -f "$ABSFILE" ] || { echo "ERROR: not a regular file: $ABSFILE" >&2; exit 1; }

# ----------------------------------------------------------------------
# RISK: LOW (green) / MEDIUM (yellow) / HIGH (red)
# ----------------------------------------------------------------------
RISK="LOW"
RISK_NOTES=""
note_risk() {
    case "$RISK:$1" in
    LOW:MEDIUM) RISK="MEDIUM"; RISK_NOTES="$2" ;;
    LOW:HIGH|MEDIUM:HIGH) RISK="HIGH"; RISK_NOTES="$2" ;;
    esac
}

# --- Metadata ---
OWNER="$(stat -f '%Su' "$ABSFILE")"
GROUP="$(stat -f '%Sg' "$ABSFILE")"
MODE="$(stat -f '%Mp%Lp' "$ABSFILE")"
SIZE="$(stat -f '%z' "$ABSFILE")"
FTYPE="$(file -b "$ABSFILE")"
HASH="$(sha256 -q "$ABSFILE" 2>/dev/null || sha256sum "$ABSFILE" 2>/dev/null | cut -d' ' -f1)"

FILE_GID="$(stat -f '%g' "$ABSFILE" 2>/dev/null)"
FILE_UID="$(stat -f '%u' "$ABSFILE" 2>/dev/null)"
FILE_MTIME="$(stat -f '%m' "$ABSFILE" 2>/dev/null)"
DROP_GID="$(grep '^drop:' /etc/group 2>/dev/null | cut -d: -f3)"

# Human-readable size
if [ "$SIZE" -ge 1048576 ]; then
    HSIZE="$((SIZE / 1048576)) MB"
elif [ "$SIZE" -ge 1024 ]; then
    HSIZE="$((SIZE / 1024)) KB"
else
    HSIZE="$SIZE bytes"
fi

# --- Content risk signals ---
# 1. Executable / script / ELF -> HIGH
case "$FTYPE" in
*executable*|*ELF*|*shell\ script*|*script\ text*|*Java\ archive*|*shared\ object*)
    note_risk HIGH "The file is executable code (type: $FTYPE). Importing and running it can compromise the destination domain."
    ;;
esac

# 2. Archive -> MEDIUM (must list contents)
case "$FTYPE" in
*gzip*|*tar\ archive*|*Zip\ archive*|*bzip2*|*xz*|*7-zip*)
    note_risk MEDIUM "The file is an archive. Inspect its contents (listed below) for executables before importing."
    ;;
esac

# 3. Documents with macros -> HIGH
case "$FTYPE" in
*Microsoft\ Word*|*Microsoft\ Excel*|*Composite\ Document*|*OLE*)
    note_risk HIGH "This is a document type that can carry macros (type: $FTYPE). Macros can execute code. Import only if you trust the source completely."
    ;;
esac

# 4. Double extension (masking) -> HIGH
BNAME="$(basename "$ABSFILE")"
case "$BNAME" in
*.pdf.exe|*.exe.pdf|*.txt.exe|*.doc.exe|*.pdf.sh|*.txt.sh|*.png.exe|*.jpg.exe|*.docx.exe|*.xls.exe|*.tar.gz.exe|*.zip.exe)
    note_risk HIGH "The filename has a double extension ($BNAME) -- a common trick to hide executables behind a document-looking name."
    ;;
esac

# 5. Extension/type mismatch (anti-masking) -> HIGH
ext="${BNAME##*.}"
case "$ext:$FTYPE" in
pdf:*executable*|pdf:*script*|pdf:*ELF*|png:*executable*|png:*script*|jpg:*executable*|jpg:*script*|txt:*executable*|txt:*ELF*|doc:*executable*|doc:*script*|docx:*executable*|xls:*executable*|zip:*executable*)
    note_risk HIGH "The filename says .$ext but the real type is '$FTYPE'. This is a strong sign of a disguised file. Do not import."
    ;;
esac

# 6. Non-text content (binary) when a text file was expected -> MEDIUM
case "$FTYPE" in
*data*|*binary*)
    note_risk MEDIUM "The file is binary data (type: $FTYPE). It is not a simple text file; inspect carefully."
    ;;
esac

# --- Transit policy (enforce_drop's view) ---
# enforce_drop decides by mtime, GID and mode, in this order:
#   1. mtime > ABANDON_MIN -> delete (abandoned), whatever the rest
#   2. wrong GID (and not root-owned) -> quarantine
#   3. wrong mode -> fix (0440 file, 0570 dir)
# A file that fails 1 or 2 is not importable: it will be removed
# before any import.
ABANDON_MIN=30
TRANSIT="OK"
TRANSIT_NOTES=""
AGE=$(( $(date +%s) - ${FILE_MTIME:-0} ))

if [ -n "$FILE_MTIME" ] && [ "$AGE" -gt $((ABANDON_MIN * 60)) ]; then
    TRANSIT="BLOCK"
    TRANSIT_NOTES="stale ($((AGE / 60))m old, limit ${ABANDON_MIN}m); enforce_drop will delete it as abandoned"
elif [ -n "$DROP_GID" ] && [ "$FILE_GID" != "$DROP_GID" ] && [ "$FILE_UID" != "0" ]; then
    TRANSIT="BLOCK"
    TRANSIT_NOTES="wrong GID ($GROUP, expected drop); enforce_drop will quarantine it"
elif [ "$MODE" != "0440" ]; then
    TRANSIT="WARN"
    TRANSIT_NOTES="mode $MODE (expected 0440); enforce_drop will fix it"
fi

# --- Output ---
echo "=== Inspect: $ABSFILE ==="
echo ""
echo "Owner: $OWNER:$GROUP"
echo "Mode: $MODE (expected 0440 in transit)"
echo "Size: $HSIZE"
echo "Type: $FTYPE"
echo "SHA256: $HASH"
echo ""
echo "=== Transit (enforce_drop) ==="
echo "GID:    $GROUP (expected drop)"
echo "Mode:   $MODE (expected 0440)"
echo "Age:    $((AGE / 60))m (limit ${ABANDON_MIN}m)"
echo "TRANSIT: $TRANSIT${TRANSIT_NOTES:+ -- $TRANSIT_NOTES}"
echo ""

# For archives: list contents (never extract)
case "$FTYPE" in
*gzip*|*tar\ archive*)
    echo "Archive contents (list only, not extracted):"
    if command -v tar >/dev/null 2>&1; then
        tar -tzf "$ABSFILE" 2>/dev/null | head -30 | sed 's/^/ /'
        echo " (list truncated to 30 entries)"
    else
        echo " (tar not available; cannot list)"
    fi
    echo ""
    ;;
esac

# For text: truncated preview
case "$FTYPE" in
*text*)
    echo "Text preview (first 40 lines):"
    head -40 "$ABSFILE" 2>/dev/null | sed 's/^/ /'
    echo ""
    ;;
esac

# --- Verdict ---
echo "=== Verdict ==="
case "$RISK" in
LOW)    echo "CONTENT: LOW -- not executable, not an archive, type matches." ;;
MEDIUM) echo "CONTENT: MEDIUM -- inspect carefully. $RISK_NOTES" ;;
HIGH)   echo "CONTENT: HIGH -- do not import unless certain. $RISK_NOTES" ;;
esac
echo "TRANSIT: $TRANSIT${TRANSIT_NOTES:+ -- $TRANSIT_NOTES}"
echo ""

if [ "$RISK" = "HIGH" ] || [ "$TRANSIT" = "BLOCK" ]; then
    echo "DO NOT IMPORT"
    exit 2
elif [ "$RISK" = "MEDIUM" ] || [ "$TRANSIT" = "WARN" ]; then
    echo "IMPORT WITH CAUTION"
    exit 1
else
    echo "IMPORT"
    exit 0
fi