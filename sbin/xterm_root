# ==========================================================
#  dropQbsd -- xterm_root
#
#  Opens an xterm running a root login shell (su -), with the dropQbsd
#  admin colour scheme (dark red background). With arguments, runs that
#  command as root instead of an interactive shell.
#
#  Environment. The wrapper unsets HOME, ENV and any caller-supplied
#  PATH, so the script declares what it needs.
#    - PATH is set explicitly, and the script exits if xterm is not in
#      it.
#    - HOME is rebuilt from /etc/passwd using the real uid: the xterm --
#      and the X11 cookie it uses -- belongs to the INVOKING user, not
#      to root. The `su -` happens INSIDE the terminal.
#    - XAUTHORITY falls back to $HOME/.Xauthority when the session does
#      not export one.
#
#  The xterm is started with `nohup ... &` like the other xterm_*
#  scripts: the alias returns at once, and the terminal outlives it.
#
#  Path: /opt/dropQbsd/sbin/xterm_root
#  Permissions: chmod 755, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_root [command [args...]]
#    OR
#    Xtroot [command [args...]]
# ==========================================================

PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/X11R6/bin:/usr/local/bin:/usr/local/sbin
export PATH

command -v xterm >/dev/null 2>&1 || { echo "xterm_root: xterm not in PATH" >&2; exit 1; }

# HOME rebuilt from passwd via real uid (the wrapper unsets it).
UID_R=$(id -ru)
HOME=$(awk -F: -v u="$UID_R" '$3 == u {print $6; exit}' /etc/passwd)
[ -z "$HOME" ] && { echo "xterm_root: cannot resolve home directory" >&2; exit 1; }
export HOME

# X11 cookie: canonical file when the session exports nothing.
[ -z "$XAUTHORITY" ] && export XAUTHORITY="$HOME/.Xauthority"

# The dropQbsd chain is Korn-shell code. Pick the same shell the
# domains use: /bin/ksh on OpenBSD, mksh on FreeBSD.
case "$(uname -s)" in
    FreeBSD) KSH=/usr/local/bin/mksh ;;
    *)       KSH=/bin/ksh ;;
esac

# `su -s` is root-only on OpenBSD ("only the superuser may specify a
# login shell"), so the conductor cannot force the shell. Do not use
# -s. Run `env` from the target's login shell instead: `env VAR=value
# command` is valid in both ksh and csh, while `VAR=value; export VAR`
# is not csh syntax (FreeBSD's root shell).
#
# ENV is how an interactive Korn shell finds /etc/dropQbsd/kshrc.
# run_app_impl sets it for the domains; xterm_root does not go through
# run_app, so it must set it here.
XENV="env XAUTHORITY='$XAUTHORITY' DISPLAY='$DISPLAY' ENV='/etc/dropQbsd/kshrc'"

if [ $# -gt 0 ]; then
    nohup xterm -T "root" -bg darkred -fg white -fa monospace -fs 12 -u8 \
        -e su -l root -c "$XENV $KSH -c \"$*\"" </dev/null >/dev/null 2>&1 &
else
    nohup xterm -T "root" -bg darkred -fg white -fa monospace -fs 12 -u8 \
        -e su -l root -c "$XENV $KSH" </dev/null >/dev/null 2>&1 &
fi
