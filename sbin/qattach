# ==========================================================
#  dropQbsd -- qattach
#
#  Attaches a file from a SOURCE domain into the Downloads
#  directory of a DESTINATION domain, so it can be attached
#  to a mail or uploaded to a website.
#
#  Invoked as:
#    run_app qattach <source>
#  run_app_impl resolves the X11 cookie and passes it here,
#  along with the display, as arguments 2 and 3.
#
#  Flow:
#    1. Hierarchical picker AS THE SOURCE (Xdialog), confined
#       to the source's home. The user picks a file.
#    2. Destination menu (Xdialog), from attach.conf.
#    3. qimport AS THE DESTINATION: the staged file is known
#       by name, so no third picker is needed.
#
#  The picker runs AS THE DOMAIN IT BELONGS TO, never as root.
#  Xdialog is pure X11: it does not use MIT-SHM, so it renders
#  correctly across user boundaries (unlike GTK/zenity).
#
#  The staged file carries a unique name:
#    <basename>.<pid>.<timestamp>.qattach
#  so concurrent or failed qattach runs never collide, and
#  phase 3 knows exactly which file to import.
#
#  qattach does NOT implement transport. It orchestrates the
#  existing qcp and qimport scripts, running each one AS the
#  domain it acts on (via su -l).
#
#  Path: /opt/dropQbsd/sbin/qattach
#  Permissions: chmod 755, root:wheel
#
#  Requirements: Xdialog (Xdialog on OpenBSD, xdialog on FreeBSD).
#
#  IMPORTANT: invoked through the run_app gate:
#    /opt/dropQbsd/bin/run_app qattach <source>
#    OR
#    Qattach <source>
#  Do NOT run it directly.
#
#  PORTABILITY: PD KSH (OpenBSD) + mksh (FreeBSD).
#  Do NOT use: disown, bash arrays, [[ =~ ]], '\#*' in [[ ]].
#  Use 'case' for glob matching. ASCII only in GUI strings.
# ==========================================================

set -eu

WRAPPER="/opt/dropQbsd/libexec/wrapper"
QCP="/opt/dropQbsd/sbin/qcp"
QIMPORT="/opt/dropQbsd/sbin/qimport"

ATTACH_CONF="/etc/dropQbsd/attach.conf"
SCHEMA="/etc/dropQbsd/schema"

LOG="/var/log/dropQbsd/qattach.log"
DROP_DIR="/home/drop"

#-----------------------------------------------------------------------------
# LOGGING
#-----------------------------------------------------------------------------
log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG"
}

#-----------------------------------------------------------------------------
# ARGUMENTS: source, display, xauthority (from run_app_impl)
#-----------------------------------------------------------------------------
if [ $# -ne 3 ]; then
    echo "Usage: qattach <source-domain> <display> <xauthority>" >&2
    exit 1
fi

SRC_DOMAIN="$1"
DISPLAY_ARG="$2"
AUTH_SRC="$3"

#-----------------------------------------------------------------------------
# IDENTITY: the conductor. State lives in its cache.
#-----------------------------------------------------------------------------
# Derive the conductor account from its GECOS marker, so a renamed
# account works without touching this script. Fallback guard for
# direct invocation without the wrapper.
CONDUCTOR=""
if [ -n "${CONDUCTOR_USER:-}" ]; then
    CONDUCTOR="$CONDUCTOR_USER"
else
    CONDUCTOR="$(awk -F: '$5 == "dropQbsd_conductor" { print $1; exit }' /etc/passwd)"
fi
[ -n "$CONDUCTOR" ] || CONDUCTOR="conductor"
COND_HOME=""
COND_HOME="$(awk -F: -v u="$CONDUCTOR" '$1 == u {print $6; exit}' /etc/passwd)"
if [ -z "$COND_HOME" ] || [ ! -d "$COND_HOME" ]; then
    echo "Error: cannot resolve conductor home." >&2
    exit 1
fi
#-----------------------------------------------------------------------------
# RUNTIME DIRECTORY (root-owned state under the conductor's cache)
#-----------------------------------------------------------------------------
# MUST stay after COND_HOME is assigned above. Under `set -u` an earlier
# reference aborts with "COND_HOME: parameter not set" -- which is exactly
# the v0.4.0 crash this block was moved to fix. Do not hoist it.
CACHE_DIR="$COND_HOME/.cache"
if [ ! -d "$CACHE_DIR" ]; then
    mkdir -p "$CACHE_DIR"
    chown "$CONDUCTOR" "$CACHE_DIR"
    chmod 700 "$CACHE_DIR"
fi
RUNDIR="$CACHE_DIR/dropQbsd"
mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
# Root-owned 700: only qattach (running as root) reads and writes it.
# The conductor's cache is used as a location, not as shared state --
# the conductor cannot read the file.

#-----------------------------------------------------------------------------
# X ENVIRONMENT
#-----------------------------------------------------------------------------
if [ ! -s "$AUTH_SRC" ]; then
    echo "Error: X11 cookie '$AUTH_SRC' is empty or missing." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# RESOLVE THE XDIALOG BINARY (OpenBSD: Xdialog, FreeBSD: xdialog)
#-----------------------------------------------------------------------------
XDIALOG=""
if command -v Xdialog >/dev/null 2>&1; then
    XDIALOG="Xdialog"
elif command -v xdialog >/dev/null 2>&1; then
    XDIALOG="xdialog"
else
    echo "Error: Xdialog not found." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# DEPENDENCY CHECK
#-----------------------------------------------------------------------------
if [ ! -f "$ATTACH_CONF" ]; then
    echo "Error: $ATTACH_CONF not found." >&2
    exit 1
fi

if [ ! -f "$SCHEMA" ]; then
    echo "Error: $SCHEMA not found." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# VALIDATE A DOMAIN AGAINST schema
#-----------------------------------------------------------------------------
# schema lists the GECOS role markers ("dropQbsd_<role>"), not account
# names. A domain is valid if its GECOS marker is listed AND an account
# carries it. For the three fixed domains (userdoc, usermail, userweb)
# the account name equals the role; the conductor is never a valid
# qattach source/destination (it is not in attach.conf).
is_valid_domain() {
    _d="$1"
    _marker="dropQbsd_${_d}"   # userdoc -> dropQbsd_userdoc
    grep -v '^[[:space:]]*#' "$SCHEMA" \
    | grep -v '^[[:space:]]*$' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
    | grep -qx -- "$_marker" \
    && awk -F: -v u="$_d" -v m="$_marker" \
        '$1 == u && $5 == m { found = 1 } END { exit !found }' /etc/passwd
}

#-----------------------------------------------------------------------------
# RESOLVE A DOMAIN'S HOME
#-----------------------------------------------------------------------------
domain_home() {
    awk -F: -v u="$1" '$1 == u {print $6; exit}' /etc/passwd
}

#-----------------------------------------------------------------------------
# VALIDATE THE SOURCE AGAINST attach.conf
#-----------------------------------------------------------------------------
if ! is_valid_domain "$SRC_DOMAIN"; then
    log "error: invalid source domain '$SRC_DOMAIN'"
    exit 1
fi

if ! grep -v '^[[:space:]]*#' "$ATTACH_CONF" \
     | grep -v '^[[:space:]]*$' \
     | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
     | grep -q "^${SRC_DOMAIN}:"; then
    log "error: source '$SRC_DOMAIN' not allowed in attach.conf"
    exit 1
fi

SRC_HOME=$(domain_home "$SRC_DOMAIN")
if [ -z "$SRC_HOME" ] || [ ! -d "$SRC_HOME" ]; then
    log "error: cannot resolve home for '$SRC_DOMAIN'"
    exit 1
fi

#-----------------------------------------------------------------------------
# LOAD DESTINATIONS FOR THIS SOURCE
#-----------------------------------------------------------------------------
DEST_LIST="$RUNDIR/qattach_dests"
: > "$DEST_LIST"

while IFS= read -r _line; do
    case "$_line" in
        ''|\#*) continue ;;
    esac
    _line=$(printf '%s' "$_line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$_line" in
        ''|\#*) continue ;;
    esac
    _src=${_line%%:*}
    _dst=${_line#*:}
    [ "$_src" = "$_line" ] && continue
    [ "$_src" = "$SRC_DOMAIN" ] || continue
    is_valid_domain "$_dst" || continue
    printf '%s\n' "$_dst" >> "$DEST_LIST"
done < "$ATTACH_CONF"

if [ ! -s "$DEST_LIST" ]; then
    log "error: no destinations for source '$SRC_DOMAIN'"
    exit 1
fi

#-----------------------------------------------------------------------------
# TEMPORARY X COOKIES, ONE PER DOMAIN THAT RUNS A POPUP
#-----------------------------------------------------------------------------
# Each popup runs AS A DOMAIN (su -l). It needs a cookie it can
# read. The conductor's cookie is copied to a temp file, owned by
# that domain, mode 600, removed on exit. /tmp is sticky (1777).
TMP_AUTH_1=$(mktemp /tmp/qattach_auth1.XXXXXX)
TMP_AUTH_2=$(mktemp /tmp/qattach_auth2.XXXXXX)

cleanup() {
    rm -f "$TMP_AUTH_1" "$TMP_AUTH_2" 2>/dev/null
    rm -f "$DEST_LIST" 2>/dev/null
    # A failed run must not leave the staged item in the drop zone.
    # DROP_FINAL is assigned later; ${DROP_FINAL:-} covers the early
    # exit paths.
    if [ -n "${DROP_FINAL:-}" ]; then
        rm -rf "$DROP_FINAL" 2>/dev/null
    fi
}
trap cleanup EXIT
trap 'cleanup; trap - EXIT; exit 129' HUP
trap 'cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM

make_cookie_for() {
    _dom="$1"
    _dst="$2"
    cp "$AUTH_SRC" "$_dst"
    # chmod BEFORE chown: after chown the domain owns the file and can
    # replace it with a symlink before chmod runs, and chmod would
    # follow the link to its target.
    chmod 600 "$_dst"
    chown "$_dom" "$_dst"
}

#-----------------------------------------------------------------------------
# HIERARCHICAL PICKER
#-----------------------------------------------------------------------------
# Runs AS THE GIVEN DOMAIN, confined to the given root directory.
# The domain cannot navigate above the root: the parent case
# refuses to go past it.
#
# Tags carry an explicit type prefix:
#   P:  parent
#   D:  directory
#   F:  file
# The item (what the user sees) is the plain name.
#
# Prints the selected absolute path on stdout, or nothing on cancel.
# Return: 0 = selected, 1 = cancelled, 2 = error.
#
# Arguments: <domain> <cookie> <root> <title> <filter> <xdialog>
picker() {
    _dom="$1"
    _cookie="$2"
    _root="$3"
    _title="$4"
    _filter="$5"
    _xd="$6"
    su -l "$_dom" -c '
COOKIE="$1"; ROOT="$2"; TITLE="$3"; FILTER="$4"; XD="$5"; DSP="$6"
export DISPLAY="$DSP"
export XAUTHORITY="$COOKIE"

        cur="$ROOT"
        selected=""

        while :; do
            # Build the argument list with set --, so each tag and
            # each item is a separate argument. The shell does not
            # word-split them, so items may contain spaces.
            set -- "P:" ".."
            case "$cur" in
                "$ROOT"|"$ROOT"/) : ;;
                *) set -- "$@" "S:" "[ select this folder ]" ;;
            esac

            for e in "$cur"/*; do
                [ -e "$e" ] || continue
                name=$(basename "$e")
                case "$name" in
                    .*) continue ;;
                esac
                if [ -d "$e" ]; then
                    set -- "$@" "D:$name" "$name"
                else
                    case "$FILTER" in
                        qattach)
                            case "$name" in
                                *.qattach) set -- "$@" "F:$name" "$name" ;;
                            esac
                            ;;
                        *)
                            case "$name" in
                                *.qattach) ;;
                                *) set -- "$@" "F:$name" "$name" ;;
                            esac
                            ;;
                    esac
                fi
            done

            # --no-tags: show only the item, not the tag.
            choice=$($XD --stdout --no-tags --title "$TITLE" \
                        --menubox "Dir: $cur" 40 120 30 "$@" 2>/dev/null) || exit 1

            case "$choice" in
                "")
                    exit 1
                    ;;
                P:*)
                    case "$cur" in
                        "$ROOT"|"$ROOT"/) : ;;
                        *) cur=$(dirname "$cur") ;;
                    esac
                    ;;
                S:*)
                    selected="$cur"
                    break
                    ;;
                D:*)
                    cur="$cur/${choice#D:}"
                    ;;
                F:*)
                    selected="$cur/${choice#F:}"
                    break
                    ;;
                *)
                    exit 2
                    ;;
            esac
        done

        printf "%s" "$selected"
    ' -- "$_cookie" "$_root" "$_title" "$_filter" "$_xd" "$DISPLAY_ARG"
}

#-----------------------------------------------------------------------------
# PHASE 1: PICK A FILE FROM THE SOURCE
#-----------------------------------------------------------------------------
make_cookie_for "$SRC_DOMAIN" "$TMP_AUTH_1"

log "phase 1: picker as $SRC_DOMAIN, root=$SRC_HOME"

SELECTED=$(picker "$SRC_DOMAIN" "$TMP_AUTH_1" "$SRC_HOME" \
    "dropQbsd - qattach: pick a file ($SRC_DOMAIN)" "file" "$XDIALOG") || {
    rc=$?
    if [ "$rc" -eq 1 ]; then
        log "cancelled at phase 1"
        exit 0
    fi
    log "error: picker failed in phase 1 (rc=$rc)"
    exit 1
}

if [ -z "$SELECTED" ]; then
    log "cancelled at phase 1 (empty)"
    exit 0
fi

# Validate: inside the source's home, a regular file.
case "$SELECTED" in
    "$SRC_HOME"/*) ;;
    *)
        log "error: selected '$SELECTED' is outside $SRC_HOME"
        exit 1
        ;;
esac
if [ ! -f "$SELECTED" ] && [ ! -d "$SELECTED" ]; then
    log "error: selected '$SELECTED' is neither a file nor a directory"
    exit 1
fi

BASENAME=$(basename "$SELECTED")

log "selected: $BASENAME"

#-----------------------------------------------------------------------------
# STAGE INTO THE DROP ZONE, AS THE SOURCE, WITH A UNIQUE NAME
#-----------------------------------------------------------------------------
# The staged name is unique per run:
#   <basename>.<pid>.<timestamp>.qattach
# so concurrent or failed runs never collide, and phase 3 knows
# exactly which file to import.
#
# qcp takes a path and stages the file under its basename. To get
# the unique name, copy the file to a temp name inside the source's
# home, qcp that, then rename it in the drop zone.
#
# Staging directory: mktemp -d, not a predictable path. The source
# user owns their home and can pre-create a symlink at a predictable
# name; cp -R would follow it and write into the target as root.
# mktemp -d creates the directory with O_EXCL, so the copy destination
# cannot be pre-created. The directory stays root-owned and is made
# traversable (711) only after the copy, so the source can read the
# staged item but cannot add or replace entries in it.
#
# Symlinks: rejected. Every later chgrp/chmod/chown follows links,
# and a link to /etc/master.passwd would change a system file. The
# check runs on the staged copy AND again on the drop-zone item:
# the source user is in the drop group and can replace files in
# transit, so the second check is not redundant.
STAMP=$(date +%s)
STAGED="${BASENAME}.$$.${STAMP}.qattach"

TMP_DIR=$(mktemp -d "$SRC_HOME/.qattach_stage.XXXXXX") || {
    log "error: cannot create staging directory"
    exit 1
}
# The random suffix from mktemp is the basename qcp will use in the
# drop zone. It is unpredictable before this point, so the source
# cannot pre-create the drop-zone entry under the same name.
TMP_BASE="${TMP_DIR##*/}"
TMP_STAGE="$TMP_DIR/$TMP_BASE"

cp -R "$SELECTED" "$TMP_STAGE"

# Reject symlinks anywhere in the selected tree. cp -R preserves
# them, and the root-owned chgrp/chmod/chown below would follow
# them to their target.
if [ -L "$SELECTED" ] || find "$TMP_STAGE" -type l | grep -q .; then
    log "error: selected item contains symbolic links"
    rm -rf "$TMP_DIR"
    exit 1
fi

# The staged copy is read by qcp AS THE SOURCE. chown -R, not chown:
# a directory's contents copied by root are still root-owned, and a
# 600 file inside would be unreadable to the source.
chown -R "$SRC_DOMAIN" "$TMP_STAGE"
# Traverse only (no listing): the source must reach the staged item,
# not enumerate the staging directory.
chmod 711 "$TMP_DIR"

# Pass the path as $1, not interpolated into the -c string: the
# staged name derives from the selected file, and a name containing
# quotes or semicolons must not become shell syntax.
if ! su -l "$SRC_DOMAIN" -c "$WRAPPER $QCP \"\$1\"" -- "$TMP_STAGE"; then
    rm -rf "$TMP_DIR"
    log "error: qcp failed for $BASENAME as $SRC_DOMAIN"
    exit 1
fi
rm -rf "$TMP_DIR"

# qcp placed the file in the drop zone under TMP_BASE.
DROP_TMP="$DROP_DIR/$TMP_BASE"
DROP_FINAL="$DROP_DIR/$STAGED"
if [ ! -e "$DROP_TMP" ]; then
    log "error: qcp did not stage the file as expected"
    exit 1
fi
mv "$DROP_TMP" "$DROP_FINAL"

# Second symlink check, on the drop-zone item. The source user is in
# the drop group and can replace a file in transit; the check above
# covered the staged copy, not what qcp actually left behind.
if [ -L "$DROP_FINAL" ] || find "$DROP_FINAL" -type l | grep -q .; then
    log "error: staged item contains symbolic links"
    rm -rf "$DROP_FINAL"
    exit 1
fi

# -h: never follow a link. With the check above this is belt and
# braces, but a link that slips through must not change its target.
# chgrp -R and -h cannot be combined (OpenBSD and FreeBSD both reject
# the pair). find without -L visits symlinks as symlinks; chgrp -h
# changes the link itself, never its target.
find "$DROP_FINAL" -exec chgrp -h drop {} +
if [ -d "$DROP_FINAL" ]; then
    find "$DROP_FINAL" -type d -exec chmod 570 {} +
    find "$DROP_FINAL" -type f -exec chmod 440 {} +
else
    chmod -h 440 "$DROP_FINAL"
fi
log "staged: $STAGED"

#-----------------------------------------------------------------------------
# PHASE 2: PICK THE DESTINATION (from attach.conf)
#-----------------------------------------------------------------------------
make_cookie_for "$SRC_DOMAIN" "$TMP_AUTH_2"

DEST_MENU=""
while IFS= read -r d; do
    [ -n "$d" ] || continue
    DEST_MENU="$DEST_MENU $d $d"
done < "$DEST_LIST"

log "phase 2: destination menu"

# shellcheck disable=SC2086
DST_DOMAIN=$(su -l "$SRC_DOMAIN" -c '
DSP="$1"; COOKIE="$2"; XD="$3"; BASE="$4"
shift 4
export DISPLAY="$DSP"
export XAUTHORITY="$COOKIE"
"$XD" --stdout --no-tags --title "dropQbsd - qattach" \
    --menubox "Attach \"$BASE\" to:" 40 100 10 "$@" 2>/dev/null
' -- "$DISPLAY_ARG" "$TMP_AUTH_2" "$XDIALOG" "$BASENAME" $DEST_MENU) || DST_DOMAIN=""

if [ -z "$DST_DOMAIN" ]; then
    log "cancelled at phase 2"
    rm -f "$DROP_FINAL"
    exit 0
fi

if ! grep -qx "$DST_DOMAIN" "$DEST_LIST"; then
    log "error: refused destination '$DST_DOMAIN' (not in matrix)"
    rm -f "$DROP_FINAL"
    exit 1
fi

log "destination: $DST_DOMAIN"

#-----------------------------------------------------------------------------
# PHASE 3: TRANSPORT AS THE DESTINATION (no picker: the file is known)
#-----------------------------------------------------------------------------
DST_HOME=$(domain_home "$DST_DOMAIN")
DL="$DST_HOME/Downloads"
# The installer creates Downloads in every home, but a home may have
# been rebuilt by hand. qimport cannot write into a missing directory,
# and the failure would surface only in the log. Create it here as the
# destination user, then continue.
if [ ! -d "$DL" ]; then
    mkdir -p "$DL" || {
        log "error: cannot create $DL"
        rm -f "$DROP_FINAL"
        exit 1
    }
    chown "$DST_DOMAIN":"$DST_DOMAIN" "$DL"
    chmod 700 "$DL"
fi

# Refuse to overwrite an existing file in Downloads.
if [ -e "$DL/$BASENAME" ]; then
    log "error: '$BASENAME' already exists in $DL"
    rm -f "$DROP_FINAL"
    exit 1
fi

# Phase 2 can take minutes. The source user is in the drop group and
# can replace the staged entry while the destination menu is open;
# re-check before qimport reads it.
if [ -L "$DROP_FINAL" ] || find "$DROP_FINAL" -type l | grep -q .; then
    log "error: staged item contains symbolic links"
    rm -rf "$DROP_FINAL"
    exit 1
fi

log "qimport as $DST_DOMAIN: $STAGED"
# Pass the staged name as $1, not interpolated into the -c string:
# it derives from the selected file, and a name containing quotes
# or semicolons must not become shell syntax in the destination.
if ! su -l "$DST_DOMAIN" -c "$WRAPPER $QIMPORT \"\$1\"" -- "$STAGED"; then
    log "error: qimport failed for $STAGED as $DST_DOMAIN"
    exit 1
fi
# qimport placed the file in the destination's ~/Downloads under
# the staged name. Strip the unique suffix.
if [ ! -e "$DL/$STAGED" ]; then
    log "error: qimport did not place '$STAGED' in $DL"
    exit 1
fi
mv "$DL/$STAGED" "$DL/$BASENAME"
# -h: never follow a link. The staged item was checked twice, but a
# link that slips through must not change its target's owner.
chown -h "$DST_DOMAIN" "$DL/$BASENAME"

#-----------------------------------------------------------------------------
# DONE
#-----------------------------------------------------------------------------
su -l "$SRC_DOMAIN" -c '
DSP="$1"; COOKIE="$2"; XD="$3"; BASE="$4"; SRC="$5"; DST="$6"
export DISPLAY="$DSP"
export XAUTHORITY="$COOKIE"
"$XD" --stdout --title "dropQbsd - qattach" \
    --msgbox "Attached:\n\n $BASE\n\nfrom $SRC to $DST/Downloads" 0 0
' -- "$DISPLAY_ARG" "$TMP_AUTH_1" "$XDIALOG" "$BASENAME" "$SRC_DOMAIN" "$DST_DOMAIN" 2>/dev/null || true

exit 0

