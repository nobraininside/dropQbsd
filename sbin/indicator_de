# ==========================================================
#  dropQbsd -- indicator_de
#
#  OSD popup on domain change.
#
#  Path: /opt/dropQbsd/sbin/indicator_de
#  Permissions: chmod 755, root:wheel
#
#  Requirements: xfce4, dzen2, xdotool
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/indicator_de
#    OR
#    Indicator
#
#  Portability notes:
#    - Font: use a fontconfig name (e.g. 'DejaVu Sans:size=24'),
#      NOT an XLFD pattern. FreeBSD no longer ships core X11
#      bitmap fonts, so an XLFD such as
#      '-*-*-*-r-*-*-34-*-*-*-*-*-*-*' resolves to nothing and
#      dzen2 exits without drawing (with a fontconfig warning).
#    - HOME: the wrapper unsets HOME; dzen2/fontconfig expect it.
#      Rebuilt below from /etc/passwd via the real uid.
#    - dzen2 is launched in a detached subshell: a backgrounded
#      child in a tight loop would otherwise be killed by SIGHUP
#      before it maps its window.
#    - OSD duration: -p 1 is too short to be noticed on a busy
#      desktop; -p 3 is the practical minimum.
# ==========================================================

# indicator lock -- in a user-writable location, since the
# indicator runs as the domain user, not root.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/indicator_de.$(id -u).lock"
if ! mkdir "$LOCK" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# The wrapper unsets HOME. dzen2 (via fontconfig) needs it.
# Rebuild it from /etc/passwd using the real uid -- never from
# the environment.
HOME=$(awk -F: -v u="$(id -u)" '$3==u {print $6}' /etc/passwd)
export HOME

last_owner=""
last_change=0

find_owner() {
    typeset wid="$1" pid owner uid wm_name wm_class ps_flag

    # ps user-filter flag differs: OpenBSD -U, FreeBSD -u
    if [ "$(uname -s)" = "FreeBSD" ]; then
        ps_flag="-u"
    else
        ps_flag="-U"
    fi

    # 1. Window title -- exact domain matches
    wm_name=$(xprop -id "$wid" WM_NAME 2>/dev/null | cut -d'"' -f2)
    case "$wm_name" in
        "userweb"|"userweb "*|*" userweb")  echo "userweb"; return ;;
        "usermail"|"usermail "*|*" usermail") echo "usermail"; return ;;
        "userdoc"|"userdoc "*|*" userdoc")  echo "userdoc"; return ;;
        "user"|"user "*|*" user")  echo "user"; return ;;
        "root"|"root "*|*" root")  echo "root"; return ;;
    esac

    # 2. Window title contains [root@] -- shell prompt betrays root
    case "$wm_name" in
        *"[root@"*) echo "root"; return ;;
    esac

    # 3. _NET_WM_PID
    pid=$(xprop -id "$wid" _NET_WM_PID 2>/dev/null | awk '{print $NF}')
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
        uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
        owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ "$uid" = "0" ]; then echo "root"; return; fi
        case "$owner" in
            userweb|usermail|userdoc|user) echo "$owner"; return ;;
        esac
    fi

    # 4. WM_CLASS fallback for xfe/Thunar
    wm_class=$(xprop -id "$wid" WM_CLASS 2>/dev/null | cut -d'"' -f2)
    case "$wm_class" in
        "xfe"|"Xfe"|"Thunar"|"thunar")
            for domain in userweb usermail userdoc; do
                if ps "$ps_flag" "$domain" -o comm= 2>/dev/null | grep -qi "$wm_class"; then
                    echo "$domain"; return
                fi
            done
            ;;
    esac

    echo "unknown"
}


while true; do
    raw=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
    active_id=$(echo "$raw" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' ')

    if [ -z "$active_id" ] || [ "$active_id" = "0x0" ]; then
        last_owner=""
        sleep 0.5
        continue
    fi

    owner=$(find_owner "$active_id")
    now=$(date +%s)

    if [ "$owner" != "$last_owner" ] && [ -n "$owner" ] && [ "$owner" != "unknown" ]; then
        if [ $(( now - last_change )) -gt 1 ]; then
            case "$owner" in
                userweb)  fg_color="#3399FF" ;;
                usermail) fg_color="#BB66EE" ;;
                userdoc)  fg_color="#33CC33" ;;
                user)     fg_color="#FFFFFF" ;;
                root)     fg_color="#FF3333" ;;
                *)        fg_color="#666666" ;;
            esac

            geom=$(xdotool getwindowgeometry "$active_id" 2>/dev/null)
            if [ -n "$geom" ]; then
                wx=$(echo "$geom" | grep "Position" | awk '{print $2}' | cut -d',' -f1)
                wy=$(echo "$geom" | grep "Position" | awk '{print $2}' | cut -d',' -f2)
                ww=$(echo "$geom" | grep "Geometry" | awk '{print $2}' | cut -d'x' -f1)
                wh=$(echo "$geom" | grep "Geometry" | awk '{print $2}' | cut -d'x' -f2)
                if [ -n "$wx" ] && [ -n "$ww" ] && [ -n "$wy" ] && [ -n "$wh" ]; then
                    px=$(( wx + ww/2 - 200 ))
                    py=$(( wy + wh/2 - 40 ))
                    [ "$px" -lt 0 ] && px=0
                    [ "$py" -lt 0 ] && py=0
                else
                    px=200; py=200
                fi
            else
                px=200; py=200
            fi

            # Detached subshell: a backgrounded dzen2 in a tight
            # loop can be killed by SIGHUP before it maps.
            ( echo "^bg(#000000) ^fg(${fg_color})  ${owner}  ^fg()^bg()" | \
                dzen2 -p 3 -x "$px" -y "$py" -h 60 -w 400 -ta c \
                      -fn 'DejaVu Sans:size=24' >/dev/null 2>&1 & )

            last_change=$now
        fi
        last_owner="$owner"
    fi

    sleep 0.5
done
