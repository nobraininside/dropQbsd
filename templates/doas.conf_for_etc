# dropQbsd -- example /etc/doas.conf
#
# Path: /etc/doas.conf on OpenBSD,
#       /usr/local/etc/doas.conf on FreeBSD (the port).
#
# One line: root may run commands as itself without a password.
# The conductor has NO doas rule; it reaches root only through the gate
# which can only launch domain applications.

permit nopass root
