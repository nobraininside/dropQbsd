# ==========================================================
#  dropQbsd -- schema
#
#  Lists the valid domains for this product
#  (dropQbsd-desktop). One domain per line.
#  Comments (#) are ignored.
#
#  Read by gen_firewall to know which domains to process.
#  This file is PRODUCT IDENTITY, not local configuration:
#  dropQbsd-desktop has 4 domains; dropQbsd-paired/server
#  will have their own schema.
#
#  NOTE: "root" is intentionally absent. Root's network
#  access (the <updates> table) is hardcoded in
#  gen_firewall, not generated from this list.
#
#  Path: /etc/dropQbsd/schema
#  Permissions: chmod 644, root:wheel
# ==========================================================

user
userweb
usermail
userdoc
