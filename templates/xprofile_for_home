# ==========================================================
#  dropQbsd -- xprofile_for_home
#
#  Universal per-user X session hook. Read by SDDM and LightDM
#  on both OpenBSD and FreeBSD. startx reads ~/.xinitrc, which
#  does not source this file.
#
#  Installed as ~/.xprofile in the home of every dropQbsd
#  user (user, userdoc, usermail, userweb) and root.
#
#  Installation:
#      cp /opt/dropQbsd/templates/xprofile_for_home ~/.xprofile
#      chown <user>:<user> ~/.xprofile
#      chmod 644 ~/.xprofile
#
#  Notes:
#    - The domain indicator is started here, in a detached
#      subshell that waits for the window manager to publish a
#      real _NET_ACTIVE_WINDOW before launching. This works with
#      any EWMH-compliant WM (XFCE, MATE, ...).
#    - The indicator is also launched from ~/.xsession (xenodm)
#      and ~/.xinitrc (startx / SDDM User Session). SDDM and
#      LightDM read this file. Its internal lock, keyed by uid,
#      prevents a double start when more than one of these files
#      is read in the same session.
# ==========================================================

# dropQbsd-stub: 0.4.0
# Sources /etc/dropQbsd/kshrc. Bump the marker above when the project's
# part of this stub changes: the updater compares the marker, not the file.

# --- Load the dropQbsd environment -------------------------------
if [ -f /etc/dropQbsd/kshrc ]; then
    . /etc/dropQbsd/kshrc
fi

export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export DISPLAY="${DISPLAY:-:0.0}"

# Apply the X11 keyboard layout configured in [keyboard] layout.
if [ -n "${DROPQBSD_XKB:-}" ]; then
    command -v setxkbmap >/dev/null 2>&1 && setxkbmap "$DROPQBSD_XKB"
fi

# Start xbindkeys (global hotkey -> qmenu) ONLY for the conductor.
# Domains run no xbindkeys and cannot launch the conductor menu.
if [ "$(id -un)" = "$CONDUCTOR_USER" ]; then
    # One xbindkeys per session. X grants a key grab to a single client,
    # so a second instance can end up owning Mod4+q depending on start
    # order. indicator_de carries a uid-keyed lock for the same reason. 
    if ! pgrep -x -U "$(id -u)" xbindkeys >/dev/null 2>&1; then
        ( xbindkeys -n & ) 
    fi
fi

# --- Start the domain indicator ----------------------------------
# Detached subshell: survives whatever execs the session next.
# It polls _NET_ACTIVE_WINDOW until a REAL window id appears.
# The atom has TWO fields ("0x... , 0x0"); the second is always
# 0x0, so only the FIRST field is tested.
(
    i=0
    while [ $i -lt 240 ]; do
        atom=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
        active=$(echo "$atom" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' \n')
        if [ -n "$active" ] && [ "$active" != "0x0" ]; then
            break
        fi
        sleep 0.5
        i=$(( i + 1 ))
    done
    exec /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/indicator_de
) >/dev/null 2>&1 &

# Pin X's DPI before the session starts. The WM reads this value at startup.
command -v xrandr >/dev/null 2>&1 && xrandr --dpi 96
