# ==========================================================
#  dropQbsd -- xinitrc_for_home
#
#  Per-user X session script for startx (FreeBSD) and for the
#  SDDM "User Session" (xinitrc.desktop).
#  Installed as ~/.xinitrc in the home of every dropQbsd
#  user (user, userdoc, usermail, userweb) and root.
#
#  Installation:
#      cp /opt/dropQbsd/templates/xinitrc_for_home ~/.xinitrc
#      chown <user>:<user> ~/.xinitrc
#      chmod 644 ~/.xinitrc
#
#  Coverage:
#    startx from a text console reads ~/.xinitrc. SDDM reads it
#    only for the "User Session" (xinitrc.desktop); for the
#    xfce.desktop / mate.desktop sessions SDDM reads ~/.xprofile
#    instead. The indicator is launched from both files; its
#    uid-keyed lock prevents a double start.
#
#  IMPORTANT: adjust the last line to your window manager or
#  desktop environment (xfce4-session, mate-session, cwm, twm,
#  i3, ...).
#
#  Notes:
#    - startx does not run a login shell: /etc/profile is NOT
#      read. The sourcing below is therefore mandatory.
# ==========================================================

if [ -f /etc/dropQbsd/kshrc ]; then
    . /etc/dropQbsd/kshrc
fi

# --- Start the domain indicator ----------------------------------
# Detached subshell: waits for a real _NET_ACTIVE_WINDOW, then
# launches the indicator. The atom has TWO fields ("0x... , 0x0");
# only the FIRST is tested. The indicator's uid-keyed lock
# prevents a double start if ~/.xprofile is read as well.
(
    i=0
    while [ $i -lt 240 ]; do
        atom=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
        active=$(echo "$atom" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' ')
        if [ -n "$active" ] && [ "$active" != "0x0" ]; then
            break
        fi
        sleep 0.5
        i=$(( i + 1 ))
    done
    exec /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/indicator_de
) >/dev/null 2>&1 &

# --- Launch the desktop session ----------------------------------
exec xfce4-session


