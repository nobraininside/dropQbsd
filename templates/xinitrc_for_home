# ==========================================================
#  dropQbsd -- xinitrc_for_home
#
#  Per-user X session script for startx (FreeBSD) and for the
#  SDDM "User Session" (xinitrc.desktop).
#  Installed as ~/.xinitrc in the home of every dropQbsd
#  user (user, userdoc, usermail, userweb) and root.
#
#  Installation:
#      cp /opt/dropQbsd/templates/xinitrc_for_home ~/.xinitrc
#      chown <user>:<user> ~/.xinitrc
#      chmod 644 ~/.xinitrc
#
#  Coverage:
#    startx from a text console reads ~/.xinitrc. SDDM reads it
#    only for the "User Session" (xinitrc.desktop); for the
#    xfce.desktop / mate.desktop sessions SDDM reads ~/.xprofile
#    instead. The indicator is launched from both files; its
#    uid-keyed lock prevents a double start.
#
#  IMPORTANT: set [session] wm in /etc/dropQbsd/local.conf.
#  The last line runs libexec/session, which reads that value.
#
#  Notes:
#    - startx does not run a login shell: /etc/profile is NOT
#      read. The sourcing below is therefore mandatory.
# ==========================================================

# dropQbsd-stub: 0.4.0
# Sources /etc/dropQbsd/kshrc. Bump the marker above when the project's
# part of this stub changes: the updater compares the marker, not the file.

if [ -f /etc/dropQbsd/kshrc ]; then
    . /etc/dropQbsd/kshrc
fi

export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export DISPLAY="${DISPLAY:-:0.0}"

# Start xbindkeys (global hotkey -> qmenu) ONLY for the conductor.
# Domains run no xbindkeys and cannot launch the conductor menu.
if [ "$(id -un)" = "$CONDUCTOR_USER" ]; then
    # One xbindkeys per session. X grants a key grab to a single client,
    # so a second instance can end up owning Mod4+q depending on start
    # order. indicator_de carries a uid-keyed lock for the same reason. 
    if ! pgrep -x -U "$(id -u)" xbindkeys >/dev/null 2>&1; then
        ( xbindkeys -n & )
    fi
fi

# --- Start the domain indicator ----------------------------------
# Detached subshell: waits for a real _NET_ACTIVE_WINDOW, then
# launches the indicator. The atom has TWO fields ("0x... , 0x0");
# only the FIRST is tested. The indicator's uid-keyed lock
# prevents a double start if ~/.xprofile is read as well.
(
    i=0
    while [ $i -lt 240 ]; do
        atom=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null)
        active=$(echo "$atom" | sed 's/.*window id # //' | cut -d',' -f1 | tr -d ' ')
        if [ -n "$active" ] && [ "$active" != "0x0" ]; then
            break
        fi
        sleep 0.5
        i=$(( i + 1 ))
    done
    exec /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/indicator_de
) >/dev/null 2>&1 &

# Pin X's DPI to 96 before the WM starts. Otherwise X derives it from the
# monitor's reported physical size, and on some panels that yields fonts
# far larger than intended. The WM reads this value at startup, so it has
# to run after the session environment is set and before `exec`.
command -v xrandr >/dev/null 2>&1 && xrandr --dpi 96

# --- Launch the desktop session ----------------------------------
# The WM is read from [session] wm in /etc/dropQbsd/local.conf.
exec /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/session


