# ==========================================================
#  dropQbsd -- xinitrc_for_home
#
#  Per-user X session script for startx (FreeBSD).
#  Installed as ~/.xinitrc in the home of every dropQbsd
#  user (user, userdoc, usermail, userweb) and root.
#
#  Installation:
#      cp /opt/dropQbsd/templates/xinitrc_for_home ~/.xinitrc
#      chown <user>:<user> ~/.xinitrc
#      chmod 644 ~/.xinitrc
#
#  Coverage:
#    startx from a text console reads ~/.xinitrc. Without it,
#    the graphical session would start with no dropQbsd
#    environment.
#
#  IMPORTANT: adjust the last line to your window manager or
#  desktop environment (xfce4-session, cwm, twm, i3, ...).
#
#  Notes:
#    - startx does not run a login shell: /etc/profile is NOT
#      read. The sourcing below is therefore mandatory.
# ==========================================================

if [ -f /etc/dropQbsd/kshrc ]; then
    . /etc/dropQbsd/kshrc
fi

# Launch the domain indicator in the background.
# nohup: the exec below replaces the shell, and background jobs
# would otherwise receive SIGHUP and exit.
nohup /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/indicator_de >/dev/null 2>&1 &

# --- Launch the desktop session ---
exec xfce4-session
