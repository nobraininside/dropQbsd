# ==========================================================
# dropQbsd -- .xsession
#
# X session startup. Sourced by xenodm(1) at login.
# Copy to: ~/.xsession
#
# OpenBSD: xenodm sources ~/.xsession
# FreeBSD: xdm sources ~/.xsession (symlink from .xinitrc if needed)
# ==========================================================

[ -f /etc/profile ] && . /etc/profile
xrandr --dpi 96

case "$USER" in
    user)
        if command -v startxfce4 >/dev/null 2>&1; then
            /opt/dropQbsd/bin/indicator_xfce4 &
            exec /usr/local/bin/startxfce4
        else
            /opt/dropQbsd/bin/indicator_cwm &
            exec /usr/X11R6/bin/cwm
        fi
        ;;
    *)
        exec /usr/X11R6/bin/cwm
        ;;
esac
