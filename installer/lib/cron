# ==========================================================
#  dropQbsd installer -- cron
#
#  Merges the dropQbsd cron entries into root's crontab.
#
#  crontab(1) REPLACES the whole table; it does not append.
#  The merge therefore strips the previous BEGIN/END block before
#  appending the template, so repeated runs do not duplicate entries.
#
#  All dropQbsd jobs run as root. Jobs that act on behalf of
#  a domain user use `su -l <user> -c`; there are no per-user
#  crontabs.
#
#  ORDER: this step runs AFTER setup_integrity (Sign) and
#  verify_integrity_setup (Verify). INSTALL_MANUAL.md §10.8: "Sign
#  must run before the verify_integrity cron job is added."
#
#  The verify_integrity entry is CONDITIONAL on the signature
#  actually existing. If the operator skipped integrity setup,
#  no signature exists, and installing the job would make cron
#  log SETUP INCOMPLETE every 5 minutes forever. The condition
#  is on the signature's presence, not on the operator's answer.
#
#  Exclusions asserted below (INSTALL_MANUAL.md 8):
#  - root_snapshot is on demand from qcontrol, NOT cron.
#  - ensure_updates_table is NOT scheduled. <updates> is populated on
#    entry of each update script and must stay empty at rest: the egress
#    rule that admits traffic to it is scoped to `user root`, so a
#    populated table means a permanent path to the mirrors. The check
#    below warns rather than fails -- on an upgrade from an older
#    version the line can survive OUTSIDE the # BEGIN dropQbsd block,
#    because the block replacement only covers what is inside it. 
#
#  Sourced by install.sh. No shebang, no extension.
# ==========================================================

install_cron() {
    if [ "$DRY_RUN" = true ]; then
        info "[dry-run] would merge the dropQbsd entries into root's crontab"
        return 0
    fi

    example="${INSTALL_DIR}/examples/system/crontab.example"
    [ -f "$example" ] || fail "crontab example missing: $example"

    tmp="$(mktemp)" || fail "mktemp failed"
    trap 'rm -f "$tmp"' EXIT

    # Preserve existing entries that are not ours: drop the old
    # BEGIN/END block, then append the shipped one.
    crontab -l 2>/dev/null \
        | sed '/^# BEGIN dropQbsd$/,/^# END dropQbsd$/d' > "$tmp"

    # Condition the verify_integrity entry on the signature
    # existing. All other jobs are always installed.
    sig="${INSTALL_DIR}/keys/dropQbsd_scripts.sha256.sig"
    if [ -f "$sig" ]; then
        info "integrity signature present: installing verify_integrity job"
        cat "$example" >> "$tmp"
    else
        info "no integrity signature: installing cron WITHOUT verify_integrity"
        grep -v 'verify_integrity' "$example" >> "$tmp"
    fi

    crontab "$tmp"
    rm -f "$tmp"
    trap - EXIT

    # In dry-run the crontab was not modified: the run above was
    # printed, not executed. Verifying now would test the OLD
    # crontab and report a false result.
    if [ "$DRY_RUN" = true ]; then
        info "[dry-run] skipping cron verification"
        return 0
    fi

    check_sh "crontab -l | grep -q dropQbsd"

    # Assert the schedule shape. root_snapshot must NOT be in cron
    # (it runs unasked). ensure_updates_table must NOT be in cron: 
    # the table is populated on entry by the update scripts and
    # must stay empty at rest. 
    if crontab -l 2>/dev/null | grep -q 'ensure_updates_table'; then
        warn "crontab still schedules ensure_updates_table -- remove that line"
    fi 
    check_sh "! crontab -l | grep -q root_snapshot"

    # Every job must reference a script that exists and is
    # executable, or cron fails silently every cycle.
    check_cron_scripts

    success "cron jobs installed"
}

# check_cron_scripts: extract the script paths from the installed
# crontab and verify each is executable. A missing script would
# otherwise fail silently, once per schedule, forever.
check_cron_scripts() {
    missing=0
    for s in $(crontab -l 2>/dev/null \
               | grep dropQbsd \
               | grep -o '/opt/dropQbsd/[^ ]*'); do
        case "$s" in
            */wrapper) continue ;;   # the wrapper itself
        esac
        if [ ! -x "$s" ]; then
            warn "cron references a non-executable script: $s"
            missing=$((missing + 1))
        fi
    done
    [ "$missing" -eq 0 ] || warn "$missing cron script(s) missing or not executable"
}


