# ==========================================================
#  dropQbsd installer -- examples
#
#  Installs the "working environment" from INSTALL_MANUAL.md 10.1
#  through 10.5: the per-domain colour scheme and the tools
#  that make the domain model usable.
#
#  In a compartmentalized system the colour is FUNCTIONAL: it
#  tells you which domain you are in. The same colours are used
#  by the terminals (xterm_*), mc (skins), nnn, and the xfe
#  launchers. Without them the domain model is correct but
#  unusable -- you cannot tell userweb from usermail without
#  reading the prompt.
#
#  OWNERSHIP POLICY (v0.4.0):
#
#  Two classes, and they must not be confused:
#
#  OVERWRITTEN (a backup is taken first, in BACKUP_DIR):
#    ~/.exrc, ~/.config/mc/ini, ~/.config/mc/menu,
#    ~/.config/nnn/plugins, ~/.config/xfe/scripts, and the mc skins.
#    These are the project's defaults for the working environment;
#    the installer keeps them current with the shipped version.
#
#  INSTALL-ONLY-IF-ABSENT (operator-owned, never overwritten):
#    ~/.gtkrc-2.0, ~/.config/xfe/xferc, ~/.config/xfe/xfwrc,
#    ~/.xbindkeysrc.
#    These are personal: the operator may customise them, and an
#    update must not clobber the customisation.
#
#  The mc skins sit in the first group on purpose: they are colour
#  definitions, not personal config, and the domain colour convention
#  must stay current.
#
#  What this does NOT install (INSTALL_MANUAL.md 10.7-10.15):
#    control panel, domain indicator, integrity (handled by the
#    integrity module), site menu, Syncthing, VLC.
#
#  Sourced by install.sh and update.sh. No shebang, no extension.
# ==========================================================

# install_examples: the bulk block of INSTALL_MANUAL.md 10.1.
#
# Per-account files are installed for root, conductor, userdoc,
# usermail, userweb. 
# Run ONCE -- running it per-account would chown those files to
# the last user in the loop.
install_examples() {
    CONDUCTOR_USER="${CONDUCTOR_USER:-$(awk -F: '$5 == "dropQbsd_conductor" { print $1; exit }' /etc/passwd)}"
    CONDUCTOR_USER="${CONDUCTOR_USER:-conductor}"
    apps="${INSTALL_DIR}/examples/apps"
    [ -d "$apps" ] || {
        warn "examples/apps not found: $apps -- skipping desktop integration"
        return 0
    }

    # Per-account: root uses wheel; domains use their own group.
    # root is a role too: mc/ini.root and mc/skins/root.ini are shipped
    # for it (dark red). Only the GTK theme and the Xfe seeds have no
    # root variant, and those two blocks skip it by name.
    install_examples_for root /root wheel root

    # Each domain: role (suffix of the mc/ and gtk/ template names) and
    # account (the real Unix user) can differ for the conductor.
    # For the other three they coincide.
    for role in conductor userdoc usermail userweb; do
        case "$role" in
            conductor) acct="$CONDUCTOR_USER" ;;
            *)         acct="$role" ;;
        esac
        h="$(home_of "$acct")"
        if [ -z "$h" ] || [ ! -d "$h" ]; then
            warn "home directory not found for $acct, skipping examples"
            continue
        fi
        install_examples_for "$acct" "$h" "$acct" "$role"
    done
}

# install_examples_for: mc skins, mc ini, nnn plugins and vi
# config for one account. u = user, h = home, grp = owning group.
#
# All files are overwritten with a backup taken first (in
# BACKUP_DIR). The overwrite keeps the operator current with
# the project's defaults; the backup is the safety net.
install_examples_for() {
    u="$1"; h="$2"; grp="$3"; role="$4"
    apps="${INSTALL_DIR}/examples/apps"

    # ------------------------------------------------------------------
    # Blocks that do NOT depend on $role: run for every account,
    # including root (role=""). These copy whole directories or a
    # fixed file, so there is no per-role suffix to resolve.
    # ------------------------------------------------------------------

    # --- Midnight Commander: skins (all, project-owned) ---------------
    if [ -d "${apps}/mc/skins" ]; then
        run mkdir -p "${h}/.local/share/mc/skins" "${h}/.config/mc"
        run chown "$u":"$grp" "${h}/.config" "$h/.local"
        run cp -R "${apps}/mc/skins/." "${h}/.local/share/mc/skins/"
        run chown -R "$u":"$grp" "${h}/.local/share/mc/skins" "${h}/.config/mc"
        run sh -c "find '${h}/.local/share/mc/skins' -type d -exec chmod 755 {} +"
        run sh -c "find '${h}/.local/share/mc/skins' -type f -exec chmod 644 {} +"
    fi

    # --- nnn plugins (all, project-owned) -----------------------------
    if [ -d "${apps}/nnn/plugins" ]; then
        backup_before_overwrite "${h}/.config/nnn/plugins"
        run mkdir -p "${h}/.config/nnn/plugins"
        run cp -R "${apps}/nnn/plugins/." "${h}/.config/nnn/plugins/"
        run chown -R "$u":"$grp" "${h}/.config/nnn/plugins"
        run sh -c "find '${h}/.config/nnn/plugins' -type d -exec chmod 755 {} +"
        run sh -c "find '${h}/.config/nnn/plugins' -type f -exec chmod 755 {} +"
    fi

    # --- vi config (fixed file) ---------------------------------------
    if [ -f "${apps}/vi/exrc" ]; then
        backup_before_overwrite "${h}/.exrc"
        run cp "${apps}/vi/exrc" "${h}/.exrc"
        run chown "$u":"$grp" "${h}/.exrc"
        run chmod 644 "${h}/.exrc"
    elif [ "$DRY_RUN" = true ]; then
        info "[dry-run] vi/exrc will be copied by the replace step"
    fi

    # ------------------------------------------------------------------
    # Blocks that DO depend on $role: run only when a role is given.
    # The suffix is the ROLE, not the account: the conductor account may
    # be renamed, but the file is always "ini.conductor".
    #
    # root IS a role: mc/ini.root and mc/skins/root.ini exist, and root
    # gets the dark red skin like every other account. It has no GTK
    # theme and no Xfe seed -- root runs neither pickers nor a GUI file
    # manager -- so those two blocks skip it by name.
    # ------------------------------------------------------------------
    if [ -n "$role" ]; then

        # --- mc ini: selects the domain skin (role-specific) ----------
        if [ -d "${apps}/mc/skins" ]; then
            if [ -f "${apps}/mc/ini.${role}" ]; then
                run cp "${apps}/mc/ini.${role}" "${h}/.config/mc/ini"
                run chmod 644 "${h}/.config/mc/ini"
            elif [ "$DRY_RUN" = true ]; then
                info "[dry-run] mc ini.${role} will be copied by the replace step" 
            else
                warn "mc ini.${role} missing, keeping default skin selection"
            fi
            if [ -f "${apps}/mc/menu_for_any" ]; then
                run cp "${apps}/mc/menu_for_any" "${h}/.config/mc/menu"
                run chmod 644 "${h}/.config/mc/menu"
            else
                warn "mc menu_for_any missing"
            fi
        fi

        # --- GTK2 theme (role-specific, operator-owned) ---------------
        # No root variant: root runs no pickers, so asking for a
        # gtk/gtkrc.root would only produce a warning on every run.
        if [ "$role" != "root" ]; then
            if [ -f "${apps}/gtk/gtkrc.${role}" ]; then
                seed_or_report "${apps}/gtk/gtkrc.${role}" "${h}/.gtkrc-2.0" "$u:$grp"
            elif [ "$DRY_RUN" = true ]; then
                info "[dry-run] GTK2 theme for role '${role}' would be copied to ${h}/.gtkrc-2.0"
            else
                warn "no GTK2 template for role '${role}': ${apps}/gtk/gtkrc.${role}"
            fi
        fi

        # --- Xfe seeds (role-specific, operator-owned) ----------------
        # No root variant: root runs no GUI file manager.
        if [ "$role" != "root" ] && [ -d "${apps}/xfe" ]; then
            for f in xferc xfwrc; do
                src="${apps}/xfe/${f}.${role}"
                if [ ! -f "$src" ]; then
                    if [ "$DRY_RUN" = true ]; then
                        info "[dry-run] Xfe seed ${f}.${role} not yet installed"
                    else
                        warn "no Xfe seed for role '${role}': $src"
                    fi
                    continue
                fi
                dst="${h}/.config/xfe/${f}"
                run mkdir -p "${h}/.config/xfe"
                if [ -e "$dst" ]; then
                    info "exists, kept: $dst"
                    continue
                fi
                run cp "$src" "$dst"
                run chown "$u:$grp" "$dst"
                run chmod 644 "$dst"
                success "installed $dst"
             done
        fi
        # --- Xfe custom actions (per-account, project-owned) ----------
        # xfqcp, xfqimport and xfqmv are code, not seeds: they call qcp,
        # qimport and qmv from the Xfe menu. Install them in every domain
        # home and keep them current, like the nnn plugins. Without them
        # the Xfe menu entries fail.
        if [ "$role" != "root" ] && [ -d "${apps}/xfe/scripts" ]; then
            backup_before_overwrite "${h}/.config/xfe/scripts"
            run mkdir -p "${h}/.config/xfe/scripts"
            run cp -R "${apps}/xfe/scripts/." "${h}/.config/xfe/scripts/"
            run chown -R "$u":"$grp" "${h}/.config/xfe/scripts"
            run sh -c "find '${h}/.config/xfe/scripts' -type d -exec chmod 755 {} +"
            run sh -c "find '${h}/.config/xfe/scripts' -type f -name 'xf*' -exec chmod 755 {} +"
        fi
    fi
    # Ensure every parent and child created above is owned by the account.
    for d in "${h}/.config" "$h/.local" "$h/.cache"; do
        if [ -d "$d" ]; then
            run chown -R "$u":"$grp" "$d"
        fi
    done
}

