# ==========================================================
#  dropQbsd installer -- files
#
#  Copies configuration, scripts, and per-home dotfiles.
#
#  Critical rule: dropQbsd configuration lives under
#  /etc/dropQbsd/. The installer must NEVER write to
#  /etc/profile, /etc/kshrc or /etc/xsession. run_app_impl
#  reads /etc/dropQbsd/kshrc via ENV_FILE; gen_fwall reads
#  /etc/dropQbsd/{domains.conf,local.conf,schema}. Those are
#  the real paths, and they are the only ones that matter.
#
#  The only system files the installer writes outside
#  /etc/dropQbsd/ are /etc/doas.conf (its canonical location)
#  and an idempotent append to /etc/newsyslog.conf.
#
#  SOURCE vs DESTINATION: REPO_ROOT is the source tree;
#  INSTALL_DIR is the destination. The installer/ directory
#  itself is NOT copied -- the installer is a source-tree-only
#  tool, run from the repository, not from /opt/dropQbsd.
#
#  Per-home dotfiles follow INSTALL_MANUAL.md 5.3 and differ between
#  OpenBSD and FreeBSD. See install_user_dotfiles below.
#
#  Sourced by install.sh and update.sh. No shebang, no extension.
# ==========================================================

TEMPLATES_DIR=""
EXAMPLES_DIR=""

files_init() {
    TEMPLATES_DIR="${REPO_ROOT}/templates"
    EXAMPLES_DIR="${REPO_ROOT}/examples/system"
}

install_files() {
    files_init

    [ -d "$TEMPLATES_DIR" ] || fail "templates dir missing: $TEMPLATES_DIR"

    # --- project-owned (templates/): copied every run ---
    run cp "${TEMPLATES_DIR}/conductor.conf_for_etc" "${ETC_DIR}/conductor.conf"
    run cp "${TEMPLATES_DIR}/domains.conf_for_etc" "${ETC_DIR}/domains.conf"
    run cp "${TEMPLATES_DIR}/schema_for_etc" "${ETC_DIR}/schema"
    run cp "${TEMPLATES_DIR}/attach.conf_for_etc" "${ETC_DIR}/attach.conf"

    # --- operator-owned (examples/): seeded once, never overwritten ---
    seed_once "${EXAMPLES_DIR}/local.conf.example" "${ETC_DIR}/local.conf" 

    # --- shell chain read by run_app_impl (ENV_FILE) and profiles ---
    run cp "${TEMPLATES_DIR}/kshrc_for_etc"   "${ETC_DIR}/kshrc"
    run cp "${TEMPLATES_DIR}/profile_for_etc" "${ETC_DIR}/profile"
    run cp "${TEMPLATES_DIR}/alias_for_etc"   "${ETC_DIR}/alias"

    # --- integrity file list read by verify_integrity ---
    run cp "${TEMPLATES_DIR}/filelist_for_etc" "${ETC_DIR}/filelist"

    # --- doas: canonical location outside /etc/dropQbsd/ ---
    # OS-specific: /etc/doas.conf on OpenBSD, /usr/local/etc/doas.conf
    # on FreeBSD (the port). DOAS_CONF comes from common.
    run cp "${TEMPLATES_DIR}/doas.conf_for_etc" "$DOAS_CONF"

    # --- newsyslog: idempotent append, never overwrite ---
    append_once "${TEMPLATES_DIR}/newsyslog_append" /etc/newsyslog.conf

    # --- rc.d for syncthing_userdoc ---
    install_rcd
    install_session_desktop

    # --- copy the scripts themselves ---
    copy_scripts

    # --- ownership of /etc/dropQbsd ---
    run chown -R root:wheel "$ETC_DIR"
    run chmod 644 "${ETC_DIR}/domains.conf" "${ETC_DIR}/schema" \
                  "${ETC_DIR}/local.conf" "${ETC_DIR}/kshrc" \
                  "${ETC_DIR}/profile" "${ETC_DIR}/alias" \
                  "${ETC_DIR}/filelist" \
                  "${ETC_DIR}/conductor.conf" "${ETC_DIR}/attach.conf"

    success "configuration and scripts installed"
}

copy_scripts() {
    for d in admin bin libexec sbin src; do
        [ -d "${REPO_ROOT}/${d}" ] || continue
        run cp -R "${REPO_ROOT}/${d}/." "${INSTALL_DIR}/${d}/"
    done
    # examples/ (apps configs, crontab, local.conf example)
    if [ -d "${REPO_ROOT}/examples" ]; then
        run cp -R "${REPO_ROOT}/examples/." "${INSTALL_DIR}/examples/"
    fi
    # templates/ copied for reference; the live copies live in
    # /etc/dropQbsd/.
    if [ -d "${REPO_ROOT}/templates" ]; then
        run cp -R "${REPO_ROOT}/templates/." "${INSTALL_DIR}/templates/"
    fi
}

install_rcd() {
    [ -d "${TEMPLATES_DIR}/rc.d" ] || return 0
    case "$OS" in
        OpenBSD)
            run cp "${TEMPLATES_DIR}/rc.d/syncthing_userdoc.openbsd" \
                   /etc/rc.d/syncthing_userdoc
            run chmod 555 /etc/rc.d/syncthing_userdoc
            ;;
        FreeBSD)
            run cp "${TEMPLATES_DIR}/rc.d/syncthing_userdoc.freebsd" \
                   /usr/local/etc/rc.d/syncthing_userdoc
            run chmod 555 /usr/local/etc/rc.d/syncthing_userdoc
            ;;
        *)
            fail "install_rcd: unsupported OS: $OS"
            ;;
    esac
}

# install_session_desktop: install the LightDM/SDDM session entry.
# The entry runs libexec/session, which reads [session] wm from local.conf.
# Operator-owned: seed once, never overwrite.
install_session_desktop() {
    src="${TEMPLATES_DIR}/dropQbsd.desktop"
    dst="/usr/local/share/xsessions/dropQbsd.desktop"
    [ -f "$src" ] || { warn "template missing: $src"; return 0; }
    if [ -e "$dst" ]; then
        info "exists, kept: $dst"
        return 0
    fi
    run mkdir -p /usr/local/share/xsessions
    run cp "$src" "$dst"
    run chown root:wheel "$dst"
    run chmod 644 "$dst"
    success "installed $dst"
}

# seed_once: install a file only if it does not exist yet.
#
# For the OPERATOR-OWNED file inside /etc/dropQbsd/: local.conf, which
# holds the LAN subnet, mail servers, [sync] directories and [extra.*]
# rules. It comes from examples/, not templates/ -- that is what marks
# it operator-owned (see lib/ownership).
#
# Project-owned files (domains.conf, schema, kshrc, profile, alias,
# filelist, conductor.conf, attach.conf) are copied unconditionally:
# they come from templates/ and the updater replaces them when they
# change.
seed_once() {
    src="$1"; dst="$2"
    [ -f "$src" ] || { warn "template missing: $src"; return 0; }
    if [ -e "$dst" ]; then
        info "exists, not overwriting (operator-owned): $dst"
        return 0
    fi
    run cp "$src" "$dst"
    success "seeded $dst from $(basename "$src")"
}

# set_script_perms: matches INSTALL_MANUAL.md §3.
# bin/, sbin/, libexec/ -> 755 root:wheel
# admin/ -> 700 root:wheel
# run_app_impl -> 700 root:wheel: the gate is the only entry point
set_script_perms() {
    run chown -R root:wheel "$INSTALL_DIR"

    for d in bin sbin libexec; do
        [ -d "${INSTALL_DIR}/${d}" ] || continue
        # Guard: an empty directory would leave the glob literal
        # and make chmod fail. Skip if there is nothing to chmod.
        if [ -n "$(ls -A "${INSTALL_DIR}/${d}" 2>/dev/null)" ]; then
            run sh -c "chmod 755 '${INSTALL_DIR}/${d}'/*"
        fi
    done

    if [ -d "${INSTALL_DIR}/admin" ] && \
       [ -n "$(ls -A "${INSTALL_DIR}/admin" 2>/dev/null)" ]; then
        run sh -c "chmod 700 '${INSTALL_DIR}/admin'/*"
    fi

    if [ -f "${INSTALL_DIR}/libexec/run_app_impl" ]; then
        run chmod 700 "${INSTALL_DIR}/libexec/run_app_impl"
    fi

    # examples/ carries scripts that the file managers invoke -- nnn
    # plugins and Xfe custom actions. A missing execute bit fails
    # silently, with no terminal to collect the error, and unlike
    # bin/sbin/libexec these directories are not covered by the loop
    # above.
    for d in examples/apps/nnn/plugins examples/apps/xfe/scripts; do
        [ -d "${INSTALL_DIR}/${d}" ] || continue
        if [ -n "$(ls -A "${INSTALL_DIR}/${d}" 2>/dev/null)" ]; then
            run sh -c "chmod 755 '${INSTALL_DIR}/${d}'/*"
        fi
    done

    success "script permissions applied"
}

# ---------------------------------------------------------------------
#  Per-home dotfiles (INSTALL_MANUAL.md 5.3) + conductor menu binding
# ---------------------------------------------------------------------

# relocate_conflicting_dotfiles: move pre-existing shell dotfiles aside
# before the stubs are installed. A fresh system ships its own
# /root/.profile (and sometimes others); install_dotfile is
# install-if-absent, so without this step the dropQbsd chain would never
# load and root would have no aliases. Files carrying the dropQbsd-stub
# marker are ours and are left alone, so a re-run is a no-op.
#
# This is INSTALL_MANUAL.md 5.1, performed by the installer instead of
# asked of the operator.
relocate_conflicting_dotfiles() {
    ts="$(date +%Y%m%d_%H%M%S)"
    for h in "$(home_of "$CONDUCTOR_USER")" \
             "$(home_of userdoc)" "$(home_of usermail)" "$(home_of userweb)" \
             /root; do
        [ -n "$h" ] && [ -d "$h" ] || continue
        for f in .profile .xprofile .xsession .xinitrc; do
            [ -f "${h}/${f}" ] || continue
            grep -q '^# dropQbsd-stub:' "${h}/${f}" 2>/dev/null && continue
            run mv "${h}/${f}" "${h}/${f}.bak.${ts}"
            success "moved aside: ${h}/${f}"
        done
    done
}

# install_user_dotfiles: install the shell-chain stubs into each
# domain user's home, and into root's home, plus the conductor's
# xbindkeys binding (via install_conductor_xbindkeys).
#
# The stubs are one-line pointers to /etc/dropQbsd/kshrc, except
# .xsession / .xinitrc which also carry the window-manager launch
# line. Coverage differs by platform (INSTALL_MANUAL.md §5.3):
#
#   .profile   always, both platforms.
#   .xprofile  always, both platforms (SDDM / LightDM).
#   .xsession  OpenBSD only (xenodm). NEVER on FreeBSD.
#   .xinitrc   both platforms (startx). On OpenBSD it is
#              harmless when xenodm is used: xenodm ignores it.
#
# CRITICAL: never install .xsession on FreeBSD. SDDM reads it and
# waits for it to exit; the `exec wm` line never returns, so the
# graphical session freezes at login. INSTALL_MANUAL.md warns about
# this explicitly. This is not a stylistic choice -- it is a bug
# that bricks the login.
#
# GROUP: root's dotfiles are root:wheel (BSD convention); the
# domain users' dotfiles are user:<own group>. This matches the
# bulk-install block in INSTALL_MANUAL.md 10.1, which uses wheel
# for root and the user's own group for the domains. Do NOT put
# root's dotfiles in the drop group.
#
# The conductor menu binding (.xbindkeysrc) is DIFFERENT from the
# stubs above: it is a real config file (not a shell-chain pointer),
# applies to both platforms, and is operator-owned -- installed
# only if absent, never overwritten, and not part of the integrity
# filelist. It is handled separately in install_conductor_xbindkeys.
install_user_dotfiles() {
    # Domain users: group is the user's own group.
    for u in $USER_LIST; do
        h="$(home_of "$u")"
        if [ -z "$h" ] || [ ! -d "$h" ]; then
            warn "home directory not found for $u, skipping dotfiles"
            continue
        fi
        install_dotfiles_for "$u" "$h" "$u"
    done

    # root: home is /root, group is wheel.
    install_dotfiles_for root /root wheel

    # Conductor menu binding: operator-owned, install once.
    install_conductor_xbindkeys

    success "per-home dotfiles ensured"
}

install_conductor_xbindkeys() {
    src="${TEMPLATES_DIR}/xbindkeys_for_conductor"
    h="$(home_of "$CONDUCTOR_USER")"
    [ -n "$h" ] || { warn "conductor home not found; skipping xbindkeysrc"; return 0; }

    seed_or_report "$src" "${h}/.xbindkeysrc" "$CONDUCTOR_USER:$CONDUCTOR_USER"

    if ! command -v xbindkeys >/dev/null 2>&1; then
        warn "xbindkeys is NOT installed -- the Super+q shortcut will not work."
        warn " Install it: pkg_add xbindkeys (OpenBSD) / pkg install xbindkeys (FreeBSD)"
    fi
}

# install_dotfiles_for: apply the platform-appropriate set for one
# user. u = user name, h = home directory, grp = owning group.
install_dotfiles_for() {
    u="$1"; h="$2"; grp="$3"

    install_dotfile "$u" "$h" "$grp" "profile_for_home"  ".profile"
    install_dotfile "$u" "$h" "$grp" "xprofile_for_home" ".xprofile"

    case "$OS" in
        OpenBSD)
            install_dotfile "$u" "$h" "$grp" "xsession_for_home" ".xsession"
            install_dotfile "$u" "$h" "$grp" "xinitrc_for_home"  ".xinitrc"
            ;;
        FreeBSD)
            # Never .xsession on FreeBSD: SDDM would freeze at login.
            install_dotfile "$u" "$h" "$grp" "xinitrc_for_home"  ".xinitrc"
            ;;
        *)
            fail "install_dotfiles_for: unsupported OS: $OS"
            ;;
    esac
}

install_dotfile() {
    u="$1"; h="$2"; grp="$3"; tmpl="$4"; dest="$5"
    src="${TEMPLATES_DIR}/${tmpl}"

    if [ ! -f "$src" ]; then
        warn "template missing: $tmpl, skipping ${h}/${dest}"
        return 0
    fi

    # A stub is project-owned logic plus one operator line (the window
    # manager). Comparing bytes would report every stub on every update,
    # because that line always differs -- and an operator may add lines
    # of their own. Compare the version marker instead: silence when the
    # stub is current, a report when the shipped stub really changed.
    if [ -e "${h}/${dest}" ]; then
        want="$(sed -n 's/^#[[:space:]]*dropQbsd-stub:[[:space:]]*//p' "$src" | head -1)"
        have="$(sed -n 's/^#[[:space:]]*dropQbsd-stub:[[:space:]]*//p' "${h}/${dest}" | head -1)"
        if [ "$want" = "$have" ]; then
            info "exists, kept: ${h}/${dest}"
        else
            DIVERGED_FILES="${DIVERGED_FILES} ${h}/${dest}:${src}"
            warn "differs from the shipped version, not written: ${h}/${dest} (shipped: ${src})"
        fi
        return 0
    fi

    run cp "$src" "${h}/${dest}"
    run chown "$u":"$grp" "${h}/${dest}"
    run chmod 644 "${h}/${dest}"
    success "installed ${h}/${dest}"
}

