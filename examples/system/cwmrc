" ==========================================================
" dropQbsd -- example .cwmrc for cwm(1)
"
" Application menu configuration for the Calm Window Manager.
" Copy to: ~/.cwmrc
"
" Contains three commented sections -- uncomment the one
" matching your role: root, domain users (userdoc/usermail/
" userweb), or conductor (user).
"
" Syntax: command <label> <path>
"   <label>   -- name shown in the application menu
"   <path>    -- executable or "xterm -e command" for
"                terminal-based applications
"
" Launch the menu: Ctrl+/
" ==========================================================

" ----------------------------------------------------------
" SECTION 1 -- root
" ----------------------------------------------------------
" command xterm          xterm_root
" command xfe            xfe
" command mc             "xterm_root mc"
" command nnn             "xterm_root nnn"
" command editor         "xterm_root vi"

" ----------------------------------------------------------
" SECTION 2a -- domain users (userdoc)
" ----------------------------------------------------------
" command xterm          xterm_userdoc
" command xfe            xfe
" command mc             "xterm_userdoc mc"
" command nnn            "xterm_userdoc nnn"
" command editor         "xterm_userdoc vi"
" command libreoffice    libreoffice
" command lyx            lyx
" command evince         evince
" command vlc            vlc

" ----------------------------------------------------------
" SECTION 2b -- domain users (usermail)
" ----------------------------------------------------------
" command xterm          xterm_usermail
" command xfe            xfe
" command mc             "xterm_usermail mc"
" command nnn            "xterm_usermail nnn"
" command editor         "xterm_usermail vi"
" command libreoffice    libreoffice
" command lyx            lyx
" command evince         evince
" command vlc            vlc

" ----------------------------------------------------------
" SECTION 2c -- domain users (userweb)
" ----------------------------------------------------------
" command xterm          xterm_userweb
" command xfe            xfe
" command mc             "xterm_userweb mc"
" command nnn            "xterm_userweb nnn"
" command editor         "xterm_userweb vi"
" command libreoffice    libreoffice
" command lyx            lyx
" command evince         evince
" command vlc            vlc

" ----------------------------------------------------------
" SECTION 3 -- conductor (user)
" ----------------------------------------------------------
" command xterm          xterm_user
" command xfe            xfe
" command mc             "xterm_user mc"
" command nnn            "xterm_user nnn"
" command editor         "xterm_user vi"
" command runweb         runweb
" command runmail        runmail
" command rundoc         rundoc

