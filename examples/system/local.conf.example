# ==========================================================
#  dropQbsd -- local.conf.example
#
#  YOUR local configuration. One file, one source of truth
#  for all of dropQbsd.
#
#  INSTALLATION:
#    1. Copy this file to /etc/dropQbsd/local.conf
#         cp /opt/dropQbsd/examples/system/local.conf.example \
#            /etc/dropQbsd/local.conf
#    2. Set ownership and permissions:
#         chown root:wheel /etc/dropQbsd/local.conf
#         chmod 644 /etc/dropQbsd/local.conf
#    3. Edit the [network] section (REQUIRED) with your LAN subnet.
#    4. Edit [mailserver] and [services] if you use them.
#    5. Regenerate the firewall and reload:
#         Gen openbsd        (or: Gen freebsd)
#         pfctl -nf /etc/pf.conf
#         pfctl -f /etc/pf.conf
#    6. Populate the PF tables:
#         Enupdates
#         Upmailserver
#         Upservices
#
#  IMPORTANT:
#    - Never commit real values to the repository.
#    - root:wheel 644 (readable by all, writable by root).
#    - Commented lines are INERT: uncomment them to activate.
#
#  Path: /etc/dropQbsd/local.conf
# ==========================================================


# ----------------------------------------------------------
# [network] -- YOUR LOCAL NETWORK (REQUIRED)
# ----------------------------------------------------------
# The LAN subnet used by userdoc (file sharing, Syncthing)
# and by any rule targeting @lan in the policy.
#
# Find it with:  ifconfig egress | grep inet
#   inet 192.168.1.42  ->  subnet is 192.168.1.0/24
#
# Use the SUBNET, not your single IP:
#   CORRECT: 192.168.1.0/24
#   WRONG:   192.168.1.42
[network]
lan = 192.168.1.0/24

# ----------------------------------------------------------
# [updates] -- UPDATE MIRRORS
# ----------------------------------------------------------
# OpenBSD uses Fastly CDN blocks (static CIDRs).
# FreeBSD uses GeoDNS hostnames (resolved via userweb DNS).
# Official source: https://api.fastly.com/public-ip-list
#
# IMPORTANT: use ONE of the two sections below, not both.
# The parser reads the FIRST [updates] section it finds.
#
# OpenBSD (default):
[updates]
mirrors = 151.101.0.0/16 199.232.0.0/16 23.235.32.0/20 104.156.80.0/20

# FreeBSD: comment the OpenBSD section above, then uncomment
# the two lines below.
# [updates]
# hosts = pkg.FreeBSD.org update.FreeBSD.org

# ----------------------------------------------------------
# [mailserver] -- YOUR MAIL SERVERS (OPTIONAL)
# ----------------------------------------------------------
# Hostnames of your IMAP and SMTP servers.
# update_mailserver_table resolves them via userweb DNS.
#
# Uncomment and replace the example values:
# hosts = mail.yourdomain.com
# or, if IMAP and SMTP differ:
# hosts = imap.yourdomain.com smtp.yourdomain.com
[mailserver]
# hosts = mail.example.com imap.example.com smtp.example.com

# ----------------------------------------------------------
# [services] -- YOUR EXTERNAL SERVICES (OPTIONAL)
# ----------------------------------------------------------
# Static IPs and @hostnames that userweb must reach beyond
# normal web browsing (ports 80/443).
# Typical: cPanel, GitHub SSH, rsync servers.
#
# Format:
#   - Static IP:  write as-is       (37.58.52.209)
#   - Hostname:   prefix with @     (@ssh.github.com)
#
# Uncomment and replace the example values:
[services]
# hosts = 198.51.100.10 @ssh.github.com

# ----------------------------------------------------------
# [extra.*] -- YOUR PERSONAL EXCEPTIONS (OPTIONAL)
# ----------------------------------------------------------
# Add EXTRA allow rules on top of the general policy
# (domains.conf). You may ONLY add "allow" here.
#
# Syntax: proto:port@target   (e.g. tcp:2083@table:services)
#
# Uncomment and adjust as needed:

# Example: cPanel + GitHub SSH + rsync for the browser
# [extra.userweb]
# allow = tcp:2083@table:services tcp:2096@table:services tcp:443@table:services tcp:52820@table:services

# Example: SSH toward the LAN (adjust port if non-standard)
# [extra.userdoc]
# allow = tcp:22@lan

# ----------------------------------------------------------
# [sync] -- ARCHIVE DIRECTORIES
# ----------------------------------------------------------
# Where the export scripts read from, and where the import
# scripts write to. If a value is omitted, the default is used.
#
# Export sources (read by export_www_to_drop / export_mail_to_drop):
#   www_src   -- default /home/userweb/www
#   mail_src  -- default /home/usermail/.mail
#
# Import destination (read by import_www_from_drop /
# import_mail_from_drop):
#   dst       -- default /home/userdoc/Sync
[sync]
dst      = /home/userdoc/Sync
www_src  = /home/userweb/www
mail_src = /home/usermail/.mail

# ----------------------------------------------------------
# [qmenu] -- APPS IN DROPQBSD MENU 
# ---------------------------------------------------------

[qmenu]
CONDUCTOR
/opt/dropQbsd/bin/run_app qattach userdoc | Qattach ~ attach file or folder from userdoc
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_conductor /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qcontrol | Qcontrol ~ monitor domains and drop
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_conductor /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qfile | Qfile ~ cross-domain file manager
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_conductor /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qprompt qinspect | Qinspect ~ check drop before import
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qsite | Qsite ~ website password manager
xfe | Xfe (conductor)
xkill | Xkill
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_conductor | Xterm (conductor)
ROOT
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_root | Xterm (root)
USERDOC
/opt/dropQbsd/bin/run_app userdoc /usr/local/bin/gimp-3.0 | Gimp
/opt/dropQbsd/bin/run_app userdoc keepassxc %f | KeePassXC
/opt/dropQbsd/bin/run_app userdoc /usr/local/bin/soffice | LibreOffice
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_userdoc mc | MC (userdoc)
/opt/dropQbsd/bin/run_app userdoc /usr/local/bin/qutebrowser --temp-basedir http://127.0.0.1:8384 | Syncthing Web
/opt/dropQbsd/bin/run_app userdoc xfe | Xfe (userdoc)
/opt/dropQbsd/bin/run_app userdoc /usr/local/bin/xpdf | Xpdf
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_userdoc | Xterm (userdoc)
USERMAIL
/opt/dropQbsd/bin/run_app usermail claws-mail | Claws Mail
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_usermail mc | MC (usermail)
/opt/dropQbsd/bin/run_app usermail thunderbird | Thunderbird
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_usermail | Xterm (usermail)
USERWEB
/opt/dropQbsd/bin/run_app userweb /usr/local/bin/librewolf --temp-profile https://qwant.com | Librewolf (disposable)
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_userweb mc | MC (userweb)
/opt/dropQbsd/bin/run_app userweb /usr/local/bin/qutebrowser --temp-basedir https://qwant.com | Qutebrowser (disposable)
/opt/dropQbsd/bin/run_app userweb /usr/local/bin/ungoogled-chromium --temp-profile https://qwant.com | Ungoogled Chromium (disposable)
/opt/dropQbsd/bin/run_app userweb xfe | Xfe (userweb)
/opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/xterm_userweb | Xterm (userweb)

