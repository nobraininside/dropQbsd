# dropQbsd -- Xfw template (userdoc domain)
#
# Partial xfwrc: ONLY the keys dropQbsd overrides. Every key not
# listed here falls back to Xfw built-in defaults and the
# system-wide xfwrc (/usr/local/share/xfe/xfwrc).
# Xfw rewrites the full file on exit; keep this template as the
# installation seed, not as a live file.

[OPTIONS]
# Domain color scheme (see INSTALL.md, color scheme convention)
textbackground=DarkGreen
textforeground=Gray100

[SETTINGS]
# Harmonized with the xfe domain scheme
basecolor=#edeceb
