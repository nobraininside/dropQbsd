#!/bin/sh
# ==========================================================
#  dropQbsd -- xfqmv
#
#  Xfe file-manager action: move the selected file(s) into
#  the drop zone.
#
#  Install:
#      cp xfqmv ~/.config/xfe/scripts/
#      chmod +x ~/.config/xfe/scripts/xfqmv
#
#  Notes:
#    - Runs as the domain user (Xfe runs inside the domain).
#    - Loops over all selected files: Xfe passes them as argv.
#    - The whole loop runs in a subshell in the background, so
#      Xfe returns immediately without spawning one process per
#      file.
#    - Errors are appended to $HOME/.cache/dropQbsd/xfe_scripts.log
#      instead of being discarded.
# ==========================================================

LOGDIR="$HOME/.cache/dropQbsd"
LOGFILE="$LOGDIR/xfe_scripts.log"
mkdir -p "$LOGDIR" 2>/dev/null

(
    for f in "$@"; do
        /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/sbin/qmv "$f" \
            >>"$LOGFILE" 2>&1
    done
) &
