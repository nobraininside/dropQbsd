# ==========================================================
#  dropQbsd -- export_www_to_drop
#
#  Compresses userweb's web directory into userweb_export, and
#  verifies the archive's integrity before publishing it.
#
#  The source directory is read from /etc/dropQbsd/local.conf,
#  section [sync], key "www_src". If absent, the default
#  /home/userweb/www is used. The source MUST exist: it holds
#  the data being exported, so a missing directory is a hard
#  error, not something to create.
#
#  Archives are published atomically: the exporter writes a
#  *.tar.gz.tmp file and renames it when complete, so an
#  importer never sees a partial archive.
#
#  Path: /opt/dropQbsd/libexec/export_www_to_drop
#  Permissions: chmod 755, root:wheel
#
#  Orphaned .tmp cleanup time is set in the CLEANUP section.
#  Archive retention is handled by enforce_drop (cron).
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage (run as userweb):
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/export_www_to_drop [-v]
#    OR
#    Exwww [-v]
#    -v   Verbose output
# ==========================================================

set -eu
umask 002

# --- source directory from local.conf [sync] www_src ----------
# The section match uses a literal comparison ($0 == "[sync]"),
# not a regex, so no backslash is needed and the pattern cannot
# be corrupted in transit.
SRC=$(awk '
    $0 == "[sync]" { s=1; next }
    /^[[]/         { s=0 }
    s && /^www_src[[:space:]]*=/ {
        sub(/^www_src[[:space:]]*=[[:space:]]*/, "")
        print
        exit
    }
' /etc/dropQbsd/local.conf)
[ -n "$SRC" ] || SRC="/home/userweb/www"

if [ ! -d "$SRC" ]; then
    echo "[ERROR] Export source does not exist: $SRC" >&2
    echo "[ERROR] Set [sync] www_src in local.conf, or create the directory" >&2 
    exit 1
fi

DST="/home/drop/userweb_export"

#-----------------------------------------------------------------------------
# VERBOSE FLAG
#-----------------------------------------------------------------------------
VERBOSE=0
[ "${1:-}" = "-v" ] && VERBOSE=1
msg() {
    if [ "$VERBOSE" -eq 1 ]; then
        echo "[INFO] $*"
    fi
}

#-----------------------------------------------------------------------------
# GUARD: DOMAIN OWNER CHECK
#-----------------------------------------------------------------------------
# Refuse to run as the wrong user. The export targets a domain's
# private directory, and mktemp would otherwise fail with a cryptic
# "Permission denied" that hides the real mistake. Fail loudly instead.
if [ "$(id -un)" != "userweb" ]; then
    echo "[ERROR] This script must run as 'userweb'." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# PRE-FLIGHT CHECKS
#-----------------------------------------------------------------------------
if [ ! -d "$SRC" ]; then
    echo "[ERROR] Source directory '$SRC' not found." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# DISK SPACE CHECK
#-----------------------------------------------------------------------------
if [ "$(df -P /home | awk 'NR==2 {print $5+0}')" -gt 90 ]; then
    echo "[ERROR] /home usage > 90%. Aborting." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# PREPARE DESTINATION
#-----------------------------------------------------------------------------
mkdir -p "$DST"

#-----------------------------------------------------------------------------
# COMPRESS
#-----------------------------------------------------------------------------
TMPDIR=$(mktemp -d /home/userweb/tmp_export.XXXXXX)
trap 'rm -rf "$TMPDIR"' EXIT INT TERM

ARCHIVE="$TMPDIR/www_$(date +%Y%m%d_%H%M%S).tar.gz"
FILENAME=$(basename "$ARCHIVE")
msg "Compressing: $ARCHIVE"
nice -n 10 tar -czf "$ARCHIVE" -C "$SRC" .

#-----------------------------------------------------------------------------
# VERIFY ARCHIVE INTEGRITY
#-----------------------------------------------------------------------------
if ! tar -tzf "$ARCHIVE" >/dev/null 2>&1; then
    echo "[ERROR] Archive corrupt after compression." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# TRANSFER TO DROP ZONE (atomic: no partial archive can ever be seen)
#-----------------------------------------------------------------------------
# Copy under a .tmp name INSIDE the drop zone, then rename. Same
# filesystem => mv is rename(2), atomic. import_www_from_drop only
# matches 'www_*.tar.gz', so an export in progress is invisible to it.
# enforce_drop (cron, every 60s) will set the correct 440 permissions.
# userweb cannot chmod here -- the export directory is root:drop.
if ! cp "$ARCHIVE" "$DST/$FILENAME.tmp"; then
    echo "[ERROR] Failed to copy archive to drop zone." >&2
    exit 1
fi
mv "$DST/$FILENAME.tmp" "$DST/$FILENAME"
msg "Copied to drop zone (atomic rename)"

#-----------------------------------------------------------------------------
# CLEANUP: orphaned .tmp from a killed run of THIS script.
# Archive retention lives in enforce_drop (single source of truth).
# adjust time to your needs: "-mtime +1" for 1 day, "-mmin +60" for 60 minutes
#-----------------------------------------------------------------------------
find "$DST" -type f -name 'www_*.tar.gz.tmp' -mmin +360 -delete 2>/dev/null

msg "Export completed successfully."
echo "Export completed: $FILENAME"
