# ==========================================================
#  dropQbsd -- enforce_sync
#
#  Monitors and sanitizes the Sync directory permissions.
#  Ensures every file and directory under /home/userdoc/Sync
#  is owned by userdoc:userdoc with correct permissions
#  (2770 for dirs, 660 for files). Runs every minute via cron
#  as root.
#
#  A grace period (GRACE_MIN) applies to both the counters and
#  the fix commands: count and action see the same set, so an
#  action can never happen without its log line. "Old enough"
#  is uniformly '-mmin +GRACE' -- one form, no mixed semantics.
#
#  Syncthing writes to temp files and renames atomically, so
#  races with this script are unlikely; the grace period is a
#  second line of defense for anything not using that pattern.
#
#  Takes an atomic mkdir lock (with a 5-minute TTL) so runs
#  that overlap do not act on the same files concurrently.
#
#  Path: /opt/dropQbsd/libexec/enforce_sync
#  Permissions: chmod 755, root:wheel
#  Cron: * * * * * /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/enforce_sync
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/enforce_sync
#    OR
#    Ensync
# ==========================================================

LOCKDIR="/var/run/enforce_sync.lock"
LOCK_TTL=900   # seconds. Used only for locks without a pid file.
LOG_FILE="/var/log/dropQbsd/enforce_sync.log"

#-----------------------------------------------------------------------------
# LOG FUNCTION
#-----------------------------------------------------------------------------
# Canonical line: "YYYY-MM-DD HH:MM:SS <message>".
# One space separator, no redundant paths, no self-references.
# Shared format with enforce_drop and verify_integrity, so a
# panel reading tail -1 always sees the same shape.
log_write() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

# lock_acquire: the lock directory carries a 'pid' file. Age alone
# cannot distinguish a killed cycle from a live but slow one, and
# reclaiming a live process's lock would let two enforcers overlap.
lock_acquire() {
    if mkdir "$LOCKDIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCKDIR/pid"
        return 0
    fi

    LOCK_AGE=$(( $(date +%s) - $(stat -f '%m' "$LOCKDIR" 2>/dev/null || echo 0) ))
    LOCK_PID=$(cat "$LOCKDIR/pid" 2>/dev/null) || LOCK_PID=""

    # No pid file: a lock from an older version. Use the TTL.
    if [ -z "$LOCK_PID" ]; then
        [ "$LOCK_AGE" -le "$LOCK_TTL" ] && return 1
        rm -f "$LOCKDIR/pid" 2>/dev/null
        rmdir "$LOCKDIR" 2>/dev/null
        mkdir "$LOCKDIR" 2>/dev/null || return 1
        printf '%s\n' "$$" > "$LOCKDIR/pid"
        return 0
    fi

    if kill -0 "$LOCK_PID" 2>/dev/null; then
        # A live process holds the lock. Never reclaim: a slow cycle
        # on a large tree is not an orphan, and a reused pid must be
        # investigated, not overridden.
        if ps -p "$LOCK_PID" -o args= 2>/dev/null | grep -q 'enforce_sync'; then
            log_write "lock held by live pid $LOCK_PID (age ${LOCK_AGE}s); skipping"
        else
            log_write "lock pid $LOCK_PID is alive but not enforce_sync; investigate"
        fi
        return 1
    fi

    # Dead pid: orphaned. Reclaim at any age.
    rm -f "$LOCKDIR/pid" 2>/dev/null
    rmdir "$LOCKDIR" 2>/dev/null
    mkdir "$LOCKDIR" 2>/dev/null || return 1
    printf '%s\n' "$$" > "$LOCKDIR/pid"
    return 0
}

if ! lock_acquire; then
    exit 0
fi
trap 'rm -f "$LOCKDIR/pid"; rmdir "$LOCKDIR" 2>/dev/null' EXIT

TARGET="/home/userdoc/Sync"
GRACE_MIN=2

#-----------------------------------------------------------------------------
# EXISTENCE CHECK
#-----------------------------------------------------------------------------
[ -d "$TARGET" ] || exit 0

#-----------------------------------------------------------------------------
# 1. COUNT NON-CONFORMING FILES/DIRS BEFORE FIXING
#    "Old enough" uniformly means: strictly older than GRACE_MIN minutes.
#-----------------------------------------------------------------------------
FILES_WRONG=$(find "$TARGET" -type f ! -perm 660 -mmin +$GRACE_MIN | wc -l | tr -d ' ')
DIRS_WRONG=$(find "$TARGET" -type d ! -perm 2770 -mmin +$GRACE_MIN | wc -l | tr -d ' ')
OWNER_WRONG=$(find "$TARGET" \( ! -user userdoc -o ! -group userdoc \) -mmin +$GRACE_MIN | wc -l | tr -d ' ')

#-----------------------------------------------------------------------------
# 2. FIX OWNER/GROUP (batch for efficiency)
#    Same age filter as the counters above: count and fix see
#    the exact same set, so every fix is reflected in the log.
#-----------------------------------------------------------------------------
find "$TARGET" \( ! -user userdoc -o ! -group userdoc \) -mmin +$GRACE_MIN -exec chown userdoc:userdoc {} +

#-----------------------------------------------------------------------------
# 3. FIX DIRECTORY PERMISSIONS (2770)
#-----------------------------------------------------------------------------
find "$TARGET" -type d ! -perm 2770 -mmin +$GRACE_MIN -exec chmod 2770 {} +

#-----------------------------------------------------------------------------
# 4. FIX FILE PERMISSIONS (660)
#-----------------------------------------------------------------------------
find "$TARGET" -type f ! -perm 660 -mmin +$GRACE_MIN -exec chmod 660 {} +

#-----------------------------------------------------------------------------
# 5. LOG ONLY IF SOMETHING WAS FIXED
#-----------------------------------------------------------------------------
TOTAL_WRONG=$((FILES_WRONG + DIRS_WRONG + OWNER_WRONG))
if [ "$TOTAL_WRONG" -gt 0 ]; then
    log_write "fixed: $FILES_WRONG file, $DIRS_WRONG dir, $OWNER_WRONG owner/group"
fi

exit 0


