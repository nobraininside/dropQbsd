#!/bin/ksh
# ==========================================================
#  dropQbsd -- ensure_updates_table
#
#  Populates the <updates> table with Fastly CDN blocks
#  from /etc/dropQbsd/local.conf, section [updates],
#  key "mirrors".
#
#  Path: /opt/dropQbsd/libexec/ensure_updates_table
#  Permissions: chmod 700, root:wheel
# ==========================================================

TABLE="updates"
LOCAL_CONF="/etc/dropQbsd/local.conf"
LOGFILE="/var/log/dropQbsd_updates.log"

log() {
    msg="$1"
    echo "$msg"
    echo "$(date '+%F %T')  $msg" >> "$LOGFILE"
}

if [ "$(id -u)" -ne 0 ]; then
    echo "Must run as root." >&2
    exit 2
fi

MIRRORS=$(grep -A3 'updates' "$LOCAL_CONF" | grep 'mirrors' | head -1 | sed 's/.*= *//')

if [ -z "$MIRRORS" ]; then
    log "FATAL: no mirrors found in $LOCAL_CONF [updates] section."
    exit 3
fi

log "Populating PF table <$TABLE> from $LOCAL_CONF..."
echo "$MIRRORS" | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' | pfctl -t "$TABLE" -T replace -f -

if [ -z "$(pfctl -t "$TABLE" -T show)" ]; then
    log "FATAL: PF table <$TABLE> is empty. Aborting."
    exit 3
fi

log "PF table <$TABLE> ready ($(pfctl -t "$TABLE" -T show | wc -l | tr -d ' ') entries)."
exit 0
