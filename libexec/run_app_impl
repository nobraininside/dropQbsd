# ==========================================================
#  dropQbsd -- run_app_impl
#
#  Launches graphical applications as a domain user with
#  X11 forwarding. The main user (conductor) invokes this
#  through a setuid wrapper (run_app) that escalates to root,
#  keeping the conductor's doas.conf clean of any privilege.
#
#  Two modes:
#    Normal:    isolated runtime directory under /tmp,
#               cleaned on exit.
#    Disposable: dedicated tmpfs mounted in RAM, destroyed
#               on exit. Nothing survives. Ideal for browsers
#               and untrusted files.
#
#  Portable across OpenBSD and FreeBSD:
#    - X11 cookie: $XAUTHORITY -> ~/.Xauthority -> xenodm
#    - tmpfs: mfs (OpenBSD) vs tmpfs (FreeBSD)
#
#  v0.3.0 changes:
#    - /tmp xauth_* fallback now filtered by INVOKING uid
#      (real uid preserved by the setuid wrapper), never
#      by target user; symlinks excluded by -type f.
#    - xenodm cookie selection picks the NEWEST A:0-* file
#      (head -1 could pick another concurrent session's cookie).
#    - eval echo ~user replaced by an /etc/passwd lookup.
#    - ENV=/etc/dropQbsd/kshrc exported to the domain shell:
#      interactive shells (! in nnn) load the dropQbsd chain
#      instead of whatever /etc/profile left behind.
#    - Unknown NNN_*/ENV overrides are now rejected instead of
#      being silently consumed and dropped.
#    - --disposable size is validated before reaching mount.
#    - Cleanup guaranteed by traps (EXIT/INT/TERM/HUP), with
#      rm -rf guards; SIGKILL orphans are collected at the
#      next run_app invocation (orphan_gc).
#    - All critical operations fail loudly instead of
#      half-configuring a session.
#
#  Paths:
#    /opt/dropQbsd/bin/run_app       (setuid C wrapper)
#    /opt/dropQbsd/libexec/run_app_impl  (this script)
#
#  Permissions:
#    run_app:      4755 root:wheel
#    run_app_impl: 0755 root:wheel
#
#  IMPORTANT: This script is invoked by the run_app gate:
#    /opt/dropQbsd/bin/run_app <target_user> <command> [args...]
#    OR
#    Run <target_user> <command> [args...]
#  Do NOT run it directly.
# ==========================================================

#-----------------------------------------------------------------------------
# CONFIGURATION
#-----------------------------------------------------------------------------
AUTH_DIR="/etc/X11/xenodm/authdir/authfiles"
DEFAULT_DISPOSABLE_SIZE="500M"
ENV_FILE="/etc/dropQbsd/kshrc"
ORPHAN_MAX_AGE=86400        # seconds: 24h, then collected by orphan_gc

#-----------------------------------------------------------------------------
# INVOKING USER (passed as $1 by run_app.c)
#-----------------------------------------------------------------------------
# run_app.c captures the conductor's real uid before setuid(0) and
# passes it as the first argument. Passing it explicitly is portable:
# on Linux setuid(0) zeroes ruid, on OpenBSD it does not. The wrapper
# cleared the environment, so this argument is the only trusted source
# of the invoking identity.
INVOKE_UID="$1"
shift

case "$INVOKE_UID" in
    ''|*[!0-9]*)
        echo "Error: invalid INVOKE_UID '$INVOKE_UID'" >&2
        exit 1
        ;;
esac

#-----------------------------------------------------------------------------
# PARSE OPTIONAL --disposable FLAG
#-----------------------------------------------------------------------------
DISPOSABLE=0
DISPOSABLE_SIZE="$DEFAULT_DISPOSABLE_SIZE"

if [[ "$1" == "--disposable" ]]; then
    DISPOSABLE=1
    shift
    case "$1" in
        [0-9]*[MG])
            DISPOSABLE_SIZE="$1"
            shift
            ;;
        *M|*G)
            echo "Error: invalid size '$1' (expected e.g. 500M, 1G)." >&2
            exit 1
            ;;
    esac
fi

#-----------------------------------------------------------------------------
# ARGUMENT CHECK
#-----------------------------------------------------------------------------
if [[ $# -lt 2 ]]; then
    echo "Usage: $(basename $0) <invoke_uid> [--disposable [size]] <target_user> [VAR=value ...] <command> [args...]" >&2
    exit 1
fi

TARGET_USER=$1
shift

#-----------------------------------------------------------------------------
# PARSE ENVIRONMENT OVERRIDES (passed as arguments)
#-----------------------------------------------------------------------------
# file_bridge passes NNN_COLORS, NNN_PLUG, NNN_BMS as arguments because
# the setuid wrapper clears the environment. Parse them here and export
# them into the target user's login shell.
NNN_COLORS=""
NNN_PLUG=""
NNN_BMS=""
ENV_EXPORT="$ENV_FILE"

while [[ "$1" == NNN_* || "$1" == ENV=* ]]; do
    case "$1" in
        NNN_COLORS=*) NNN_COLORS="${1#NNN_COLORS=}" ;;
        NNN_PLUG=*)   NNN_PLUG="${1#NNN_PLUG=}" ;;
        NNN_BMS=*)    NNN_BMS="${1#NNN_BMS=}" ;;
        ENV=*)        ENV_EXPORT="${1#ENV=}" ;;
        *)
            echo "Error: unknown override '$1' (allowed: NNN_COLORS, NNN_PLUG, NNN_BMS, ENV)." >&2
            exit 1
            ;;
    esac
    shift
done

#-----------------------------------------------------------------------------
# REQUIRE A COMMAND AFTER THE OVERRIDES
#-----------------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
    echo "Error: No command specified after overrides." >&2
    exit 1
fi

APP_CMD=$1
shift

#-----------------------------------------------------------------------------
# VERIFY TARGET USER EXISTS
#-----------------------------------------------------------------------------
if ! id "$TARGET_USER" >/dev/null 2>&1; then
    echo "Error: User '$TARGET_USER' does not exist." >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# ALLOWLIST: ONLY DOMAIN USERS PERMITTED
#-----------------------------------------------------------------------------
case "$TARGET_USER" in
    userweb|usermail|userdoc)
        ;;
    *)
        echo "Error: '$TARGET_USER' is not a valid domain user." >&2
        exit 1
        ;;
esac

#-----------------------------------------------------------------------------
# ORPHAN GARBAGE COLLECTION
#-----------------------------------------------------------------------------
# If a previous run_app_impl was SIGKILLed (traps cannot catch SIGKILL),
# its runtime directory and possibly its tmpfs survive. Collect anything
# older than ORPHAN_MAX_AGE at every launch, so accumulation is
# structurally impossible.
orphan_gc() {
    typeset d age now
    now=$(date +%s)
    for d in /tmp/disposable.* /tmp/runtime.*; do
        [[ -e "$d" ]] || continue
        age=$(( now - $(stat -f '%m' "$d" 2>/dev/null || echo "$now") ))
        [[ "$age" -lt "$ORPHAN_MAX_AGE" ]] && continue

        # If still mounted (a SIGKILLed disposable session), unmount
        # first. If unmount fails, skip this run: the directory stays
        # for the next run_app. Never rm -rf a live mount point.
        if mount | grep -q " $d "; then
            umount "$d" 2>/dev/null || continue
        fi
        rm -rf "$d" 2>/dev/null
    done
}

orphan_gc

#-----------------------------------------------------------------------------
# LOCATE X11 AUTHENTICATION COOKIE (portable across display managers)
#-----------------------------------------------------------------------------
# Precedence:
#   1. $XAUTHORITY — preserved by the setuid wrapper's whitelist
#      (set by sddm, gdm, lightdm)
#   2. xenodm auth dir — OpenBSD-specific (A:0-<random>), NEWEST
#      non-empty file; run_app_impl reads it as root
#   3. ~/.Xauthority of the INVOKING user (non-empty)
#   4. /tmp/xauth_* owned by the INVOKING user (FreeBSD sddm/gdm
#      when XAUTHORITY was not preserved). Never by the target
#      user: a compromised domain must not choose its own cookie.
#
# Every candidate must be non-empty (-s): an empty cookie file
# produces "Authorization required, but no authorization protocol
# specified" in every X client.
find_xauth() {
    typeset xa="" invoker_home

    # 1. $XAUTHORITY — only if the wrapper preserves it (whitelist).
    #    Must be non-empty: an empty file means "no cookie here".
    if [[ -n "$XAUTHORITY" && -s "$XAUTHORITY" ]]; then
        xa="$XAUTHORITY"
    fi

    # 2. xenodm auth dir — root-readable (run_app_impl is root),
    #    user-inaccessible. Newest A:0-* file; non-empty required.
    #    Preferred over the invoker's home file: xenodm keeps the
    #    LIVE session cookie here, while ~/.Xauthority may be
    #    empty or stale depending on the DM configuration.
    if [[ -z "$xa" && -d "$AUTH_DIR" ]]; then
        typeset cand
        cand=$(find "$AUTH_DIR" -maxdepth 1 -name 'A:0-*' -type f \
             -exec stat -f '%m %N' {} + 2>/dev/null \
             | sort -rn | head -1 | cut -d' ' -f2-)
        [[ -n "$cand" && -s "$cand" ]] && xa="$cand"
    fi

    # 3. ~/.Xauthority of the INVOKING user (real uid), non-empty.
    #    Fallback: some DMs keep the live cookie here.
    if [[ -z "$xa" ]]; then
        invoker_home=$(awk -F: -v u="$INVOKE_UID" \
            '$3 == u {print $6; exit}' /etc/passwd 2>/dev/null)
        if [[ -n "$invoker_home" && -s "$invoker_home/.Xauthority" ]]; then
            xa="$invoker_home/.Xauthority"
        fi
    fi

    # 4. FreeBSD sddm/gdm fallback: cookie in /tmp/xauth_*
    #    Filtered by INVOKING uid, non-empty required.
    #    Never trust another user's file.
    if [[ -z "$xa" ]]; then
        typeset cand
        cand=$(find /tmp -maxdepth 1 -name 'xauth_*' -type f \
            -uid "$INVOKE_UID" \
            -exec stat -f '%m %N' {} + 2>/dev/null \
            | sort -rn | head -1 | cut -d' ' -f2-)
        [[ -n "$cand" && -s "$cand" ]] && xa="$cand"
    fi

    printf '%s' "$xa"
}

AUTH_SRC=$(find_xauth)

if [[ -z "$AUTH_SRC" ]]; then
    echo "Error: No X11 authentication file found." >&2
    echo "       Checked: \$XAUTHORITY, invoking user's ~/.Xauthority," >&2
    echo "                $AUTH_DIR, /tmp/xauth_* (uid $INVOKE_UID)" >&2
    exit 1
fi

#-----------------------------------------------------------------------------
# MOUNT TMPFS (portable across OpenBSD and FreeBSD)
#-----------------------------------------------------------------------------
mount_tmpfs() {
    typeset size="$1"
    typeset dir="$2"
    typeset os

    os=$(uname -s)
    if [ "$os" = "FreeBSD" ]; then
        # FreeBSD tmpfs does not accept the nodev mount option.
        # The tmpfs lives in RAM and is 0700-owned by the target
        # user; device nodes cannot be created there by an
        # unprivileged process anyway.
        mount -t tmpfs -o rw,nosuid,size="$size" tmpfs "$dir"
    else
        mount -t mfs -o rw,nodev,nosuid,-s="$size" swap "$dir"
    fi
}

#-----------------------------------------------------------------------------
# SET UP RUNTIME DIRECTORY
#-----------------------------------------------------------------------------
umask 077

if [[ "$DISPOSABLE" -eq 1 ]]; then
    RUNDIR=$(mktemp -d /tmp/disposable.XXXXXX) || {
        echo "Error: cannot create runtime directory." >&2
        exit 1
    }
    if ! mount_tmpfs "$DISPOSABLE_SIZE" "$RUNDIR"; then
        echo "Error: Failed to mount tmpfs ($DISPOSABLE_SIZE). Not enough RAM?" >&2
        rmdir "$RUNDIR"
        exit 1
    fi
    chown "$TARGET_USER" "$RUNDIR"
    chmod 700 "$RUNDIR"
else
    RUNDIR=$(mktemp -d /tmp/runtime.XXXXXX) || {
        echo "Error: cannot create runtime directory." >&2
        exit 1
    }
    chown "$TARGET_USER" "$RUNDIR"
    chmod 700 "$RUNDIR"
fi

#-----------------------------------------------------------------------------
# COPY AND RESTRICT X11 COOKIE
#-----------------------------------------------------------------------------
AUTH_FILE="$RUNDIR/.Xauthority"
if ! cp "$AUTH_SRC" "$AUTH_FILE"; then
    echo "Error: cannot copy X11 cookie." >&2
    [[ "$DISPOSABLE" -eq 1 ]] && { umount "$RUNDIR" 2>/dev/null; rmdir "$RUNDIR" 2>/dev/null; }
    rm -rf "${RUNDIR:?}" 2>/dev/null
    exit 1
fi
# The copied cookie must actually contain an entry: an empty .Xauthority
# produces "Authorization required, but no authorization protocol
# specified" in every X client, long after this script is gone.
if [[ ! -s "$AUTH_FILE" ]]; then
    echo "Error: X11 cookie file '$AUTH_SRC' is empty." >&2
    [[ "$DISPOSABLE" -eq 1 ]] && { umount "$RUNDIR" 2>/dev/null; rmdir "$RUNDIR" 2>/dev/null; }
    rm -rf "${RUNDIR:?}" 2>/dev/null
    exit 1
fi
chown "$TARGET_USER" "$AUTH_FILE"
chmod 600 "$AUTH_FILE"

#-----------------------------------------------------------------------------
# DETERMINE APPLICATION HOME (no eval: passwd lookup)
#-----------------------------------------------------------------------------
if [[ "$DISPOSABLE" -eq 1 ]]; then
    APP_HOME="$RUNDIR"
else
    APP_HOME=$(awk -F: -v u="$TARGET_USER" '$1 == u {print $6; exit}' /etc/passwd)
    if [[ -z "$APP_HOME" ]]; then
        echo "Error: cannot resolve home directory for $TARGET_USER." >&2
        rm -rf "${RUNDIR:?}" 2>/dev/null
        exit 1
    fi
fi

#-----------------------------------------------------------------------------
# DOWNLOADS BRIDGE (disposable mode only)
#-----------------------------------------------------------------------------
if [[ "$DISPOSABLE" -eq 1 ]]; then
    REAL_DOWNLOADS="/home/$TARGET_USER/Downloads"
    if ! mkdir -p "$REAL_DOWNLOADS"; then
        echo "Error: cannot create $REAL_DOWNLOADS." >&2
        umount "$RUNDIR" 2>/dev/null
        rmdir "$RUNDIR" 2>/dev/null
        exit 1
    fi
    chown "$TARGET_USER" "$REAL_DOWNLOADS"
    chmod 700 "$REAL_DOWNLOADS"
    su -l "$TARGET_USER" -c "ln -sfn '$REAL_DOWNLOADS' '$RUNDIR/Downloads'"
fi

#-----------------------------------------------------------------------------
# CLEANUP (trapped: also runs on INT/TERM/HUP, not only on normal exit)
#-----------------------------------------------------------------------------
# Guards: never rm -rf an empty or unexpected path; RUNDIR always comes
# from mktemp and must match the expected prefixes.
cleanup() {
    if [[ -n "$RUNDIR" && ( "$RUNDIR" == /tmp/runtime.* || "$RUNDIR" == /tmp/disposable.* ) ]]; then
        if [[ "$DISPOSABLE" -eq 1 ]]; then
            # Unmount first; only remove the mount point if the
            # unmount succeeded. A failed unmount leaves the directory
            # for orphan_gc to collect at the next run_app.
            umount "$RUNDIR" 2>/dev/null && rmdir "$RUNDIR" 2>/dev/null
        else
            rm -rf "$RUNDIR" 2>/dev/null
        fi
    fi
}
trap cleanup EXIT
trap 'cleanup; trap - EXIT; exit 129' HUP
trap 'cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM

#-----------------------------------------------------------------------------
# LAUNCH APPLICATION AS TARGET USER
#-----------------------------------------------------------------------------
# Build the command line as a single string. Variables are expanded by
# run_app_impl (ksh) BEFORE su sees them; $* joins all app arguments.
# This avoids the positional-parameter incompatibility between ksh
# (OpenBSD) and /bin/sh (FreeBSD) in su's -c handling.
# The '--' separates su's own options from the positional parameters
# that become $1..$8 inside the target shell. $0 is the '--' itself.
su -l "$TARGET_USER" -c '
    export DISPLAY="$1"
    export XAUTHORITY="$2"
    export XDG_RUNTIME_DIR="$3"
    export HOME="$4"
    export NNN_COLORS="$5"
    export NNN_PLUG="$6"
    export NNN_BMS="$7"
    export ENV="$8"
    shift 8
    exec "$@"
' -- "$DISPLAY" "$AUTH_FILE" "$RUNDIR" "$APP_HOME" \
     "$NNN_COLORS" "$NNN_PLUG" "$NNN_BMS" "$ENV_EXPORT" "$APP_CMD" "$@"

exit 0
