# ==========================================================
#  dropQbsd -- verify_integrity
#
#  Cryptographically verifies that critical scripts have not
#  been tampered with, using signify(1). Runs every 5 minutes
#  via cron as root.
#
#  Reads /etc/dropQbsd/filelist (paths relative to
#  /opt/dropQbsd, or absolute for /etc/dropQbsd files),
#  skipping comments and blank lines -- trim happens BEFORE the
#  comment check, so an indented comment is still skipped. It
#  sha256s each file in filelist order, then verifies the
#  manifest against the detached signature using the PUBLIC key.
#
#  The filter and the order MUST match admin/sign_filelist.
#  Sign and verify are two halves of the same operation: if one
#  changes, the other must change with it, or the signature will
#  never match.
#
#  Key policy: the private key (/root/dropQbsd.sec) is
#  passphrase-encrypted and stays on disk only because this
#  script never needs it -- verification is public-key only.
#  The key is used solely during the rare interactive re-sign
#  after a monitored file changes. A plaintext key on this disk
#  is not acceptable: an attacker who can read it can re-sign
#  their own tampering, and the verification becomes theater.
#
#  This script is NOT in the filelist. It is the trust anchor:
#  the file that checks the others cannot itself be checked by
#  them. It is protected by the signature over the public key
#  and by the private-key policy above.
#
#  Path: /opt/dropQbsd/libexec/verify_integrity
#  Permissions: chmod 755, root:wheel
#  Cron: */5 * * * * /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/verify_integrity
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/verify_integrity
#    OR
#    Verify
# ==========================================================


PUBKEY="/opt/dropQbsd/keys/dropQbsd.pub"
CHECKSUM_FILE="/opt/dropQbsd/keys/dropQbsd_scripts.sha256.sig"
FILELIST="/etc/dropQbsd/filelist"
LOG="/var/log/dropQbsd/verify_integrity.log"
DETAIL_LOG="$LOG.detail"

stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# report: write one canonical line to the terminal AND the log.
# Interactive invocations (alias "Verify") get immediate feedback;
# cron runs get the same line in the log (stdout from cron is
# discarded). Format: "YYYY-MM-DD HH:MM:SS <message>" -- one
# space separator, identical to enforce_drop and enforce_sync,
# so a panel reading tail -1 always sees the same shape.
report() {
    local line
    line="$(stamp) $1"
    printf '%s\n' "$line" >&2
    printf '%s\n' "$line" >> "$LOG"
}

cd /opt/dropQbsd || { report "CANNOT cd /opt/dropQbsd"; exit 1; }

# --- Setup sanity: distinguish "not configured" from "tampered" -----
for f in "$FILELIST" "$PUBKEY" "$CHECKSUM_FILE"; do
    if [ ! -r "$f" ]; then
        report "SETUP INCOMPLETE - missing $f"
        exit 1
    fi
done

TMP=$(mktemp /tmp/verify_integrity.XXXXXX) || exit 1
trap 'rm -f "$TMP" "$TMP.files"' EXIT INT TERM

# --- Build the file list ---------------------------------------------
# Read the filelist one path per line. Skip comments and blank
# lines: verify_integrity hashes each entry, and a comment would
# be passed to sha256 as a path. Trim whitespace BEFORE the check
# so an indented comment ("  # note") is still skipped. 'case' is
# the correct glob matcher in ksh -- '[[ == \#* ]]' does not match
# '#' under PD KSH or mksh.
#
# Paths are appended one per line; xargs passes each path as a
# single argument, so paths containing spaces survive the round
# trip. The order in which the paths are hashed is the order of
# the filelist, and it MUST match the order used by
# admin/sign_filelist when the signature was produced.
FILE_ARGS="$TMP.files"
while IFS= read -r line; do
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$line" in
        ""|\#*) continue ;;
    esac

    # Resolve relative paths from /opt/dropQbsd (we cd'd above).
    # Absolute paths are used as-is.
    if [ ! -f "$line" ]; then
        report "MISSING FILE $line"
        exit 1
    fi

    printf '%s\0' "$line" >> "$FILE_ARGS"
done < "$FILELIST"

# Empty filelist would verify the wrong thing: fail loudly instead.
if [ ! -s "$FILE_ARGS" ]; then
    report "FILELIST EMPTY - $FILELIST"
    rm -f "$FILE_ARGS"
    exit 1
fi

# Hash every listed file. xargs -0 passes each path as a single
# argument, preserving spaces. The order is the filelist order,
# and it MUST match admin/sign_filelist.
xargs -0 sha256 < "$FILE_ARGS" > "$TMP" 2>&1
rm -f "$FILE_ARGS"

OUTPUT=$(signify -V -p "$PUBKEY" -x "$CHECKSUM_FILE" -m "$TMP" 2>&1)
RET=$?

if [ $RET -eq 0 ]; then
    report "OK - all files verified"
else
    report "INTEGRITY VIOLATION - re-sign with 'Sign'"
    # The raw signify output goes to a SEPARATE file: the main log
    # must contain only canonical lines, so a panel reading tail -1
    # is always reliable. The detail line carries its own timestamp.
    printf '%s %s\n' "$(stamp)" "$OUTPUT" >> "$DETAIL_LOG"
fi
