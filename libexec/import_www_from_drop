# ==========================================================
#  dropQbsd -- import_www_from_drop
#
#  Pulls the latest sites archive from the drop zone into
#  userdoc's Sync directory. Verifies integrity and keeps
#  the 3 most recent archives locally.
#
#  Cleanup of the source archive is handled by enforce_drop
#  on its regular rotation cycle. No sentinel is created.
#
#  Path: /opt/dropQbsd/libexec/import_www_from_drop
#  Permissions: chmod 755, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/import_www_from_drop
#    OR
#    Imwww
# ==========================================================

set -eu
# set -x # for debugging

SRC="/home/drop/userweb_export"

# Read the sync destination from local.conf [sync] dst, with a
# fallback to the default. The section match uses a literal
# comparison ($0 == "[sync]"), not a regex, so no backslash is
# needed and the pattern cannot be corrupted in transit.
SYNC_DST=$(awk '
    $0 == "[sync]" { s=1; next }
    /^[[]/         { s=0 }
    s && /^dst[[:space:]]*=/ {
        sub(/^dst[[:space:]]*=[[:space:]]*/, "")
        print
        exit
    }
' /etc/dropQbsd/local.conf)
[ -n "$SYNC_DST" ] || SYNC_DST="/home/userdoc/Sync"

# The destination may not exist yet (first run, or Syncthing not
# set up): create it. Unlike the export source, a missing import
# destination is not an error -- it is the normal first-run state.
if [ ! -d "$SYNC_DST" ]; then
    mkdir -p "$SYNC_DST" || {
        log "FATAL: cannot create destination: $SYNC_DST"
        exit 1
    }
fi

#-----------------------------------------------------------------------------
# PRE-FLIGHT CHECKS
#-----------------------------------------------------------------------------
if [ ! -d "$SRC" ]; then
    echo "Error: $SRC not accessible." >&2
    exit 1
fi

mkdir -p "$SYNC_DST"

#-----------------------------------------------------------------------------
# 1. FIND THE LATEST ARCHIVE
#-----------------------------------------------------------------------------
# Avoid xargs -0: OpenBSD xargs has no -r flag and runs the command
# even with empty input, listing the current directory instead.
FILES=$(find "$SRC" -maxdepth 1 -name 'www_*.tar.gz' -type f -print 2>/dev/null)


if [ -z "$FILES" ]; then
    echo "No archive found in $SRC."
    exit 0
fi

LATEST=$(printf '%s\n' "$FILES" | sort -r | head -1)
FILENAME=$(basename "$LATEST")

#-----------------------------------------------------------------------------
# 2. SKIP IF ALREADY PRESENT
#-----------------------------------------------------------------------------
if [ -f "$SYNC_DST/$FILENAME" ]; then
    echo "File $FILENAME already present in destination. Skipped."
    exit 0
fi

#-----------------------------------------------------------------------------
# 3. COPY AND SET PERMISSIONS
#-----------------------------------------------------------------------------
cp "$LATEST" "$SYNC_DST/"
chmod 600 "$SYNC_DST/$FILENAME"

#-----------------------------------------------------------------------------
# 4. VERIFY INTEGRITY
#-----------------------------------------------------------------------------
if tar -tzf "$SYNC_DST/$FILENAME" >/dev/null 2>&1; then
    echo "Archive $FILENAME imported and verified successfully."
else
    echo "ERROR: Archive $FILENAME is corrupt!" >&2
    rm "$SYNC_DST/$FILENAME"
    exit 1
fi

#-----------------------------------------------------------------------------
# 5. KEEP ONLY THE 3 MOST RECENT ARCHIVES LOCALLY
#-----------------------------------------------------------------------------
(
    cd "$SYNC_DST" || exit 1
    FILES=$(find . -maxdepth 1 -name 'www_*.tar.gz' -type f -print 2>/dev/null)
    if [ -n "$FILES" ]; then
    find "$SYNC_DST" -maxdepth 1 -name 'www_*.tar.gz' -type f 2>/dev/null \
        | sort -r \
        | tail -n +4 \
        | while IFS= read -r f; do rm -f "$f"; done 	
    fi
)

echo ">>> www sync completed."

