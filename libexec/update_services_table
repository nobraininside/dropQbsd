#!/bin/ksh
# ==========================================================
#  dropQbsd -- update_services_table
#
#  Populates the <services> PF table from
#  /etc/dropQbsd/local.conf, section [services], key "hosts".
#  Supports static IPs and hostnames (prefixed with @).
#
#  Path: /opt/dropQbsd/libexec/update_services_table
#  Permissions: chmod 700, root:wheel
# ==========================================================

LOCAL_CONF="/etc/dropQbsd/local.conf"
PF_TABLE="services"

HOSTS=$(grep -A3 'services' "$LOCAL_CONF" | grep 'hosts' | head -1 | sed 's/.*= *//')

if [ -z "$HOSTS" ]; then
    exit 0
fi

pfctl -t "$PF_TABLE" -T flush 2>/dev/null

for entry in $HOSTS; do
    case "$entry" in
        @*)
            HOSTNAME="${entry#@}"
            RESOLVED=$(su -l userweb -c "host $HOSTNAME 2>/dev/null" | sed -n 's/.* has address //p' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
            if [ -n "$RESOLVED" ]; then
                for ip in $RESOLVED; do
                    pfctl -t "$PF_TABLE" -T add "$ip" 2>/dev/null
                done
            fi
            ;;
        *)
            pfctl -t "$PF_TABLE" -T add "$entry" 2>/dev/null
            ;;
    esac
done
