# ==========================================================
#  dropQbsd -- update_mailserver_table
#
#  Resolves mail server hostnames via userweb and populates
#  the <mailserver> PF table. Root never touches the network
#  directly -- DNS resolution is delegated to userweb.
#
#  Hostnames read from /etc/dropQbsd/local.conf,
#  section [mailserver], key "hosts".
#
#  Path: /opt/dropQbsd/libexec/update_mailserver_table
#  Permissions: chmod 700, root:wheel
#
#  IMPORTANT: This script MUST be executed via the dropQbsd
#  wrapper or its alias. Do NOT run it directly.
#  Usage:
#    /opt/dropQbsd/libexec/wrapper /opt/dropQbsd/libexec/update_mailserver_table
#    OR
#    Upmailserver
# ==========================================================

PF_TABLE="mailserver"
LOCAL_CONF="/etc/dropQbsd/local.conf"
LOGFILE="/var/log/dropQbsd/update_mailserver_table.log"

log() {
    msg="$1"
    echo "$msg"
    echo "$(date '+%F %T')  $msg" >> "$LOGFILE"
}

if [ "$(id -u)" -ne 0 ]; then
    echo "Must run as root." >&2
    exit 2
fi

#-----------------------------------------------------------------------------
# Parse [mailserver] section, key "hosts".
#-----------------------------------------------------------------------------
HOSTS=$(awk '
    $0 == "[mailserver]" { s=1; next }
    $0 ~ /^[[]/          { s=0 }
    s && $0 ~ /^hosts[[:space:]]*=/ {
        sub(/^hosts[[:space:]]*=[[:space:]]*/, "")
        print
        exit
    }
' "$LOCAL_CONF")

if [ -z "$HOSTS" ]; then
    log "No hosts configured in [mailserver] section; nothing to do."
    exit 0
fi

#-----------------------------------------------------------------------------
# Resolve each hostname via userweb DNS.
#-----------------------------------------------------------------------------
RESOLVED=""
for host in $HOSTS; do
    result=$(su -l userweb -c "host $host 2>/dev/null" \
        | sed -n 's/.* has address //p' \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
    RESOLVED="$RESOLVED $result"
done

RESOLVED=$(echo "$RESOLVED" | tr ' ' '\n' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -u)

#-----------------------------------------------------------------------------
# Apply to the PF table and log the result.
#-----------------------------------------------------------------------------
if [ -n "$RESOLVED" ]; then
    OUT=$(echo "$RESOLVED" | pfctl -t "$PF_TABLE" -T replace -f - 2>&1)
    log "$OUT"
    log "mailserver table updated: $(echo "$RESOLVED" | wc -l | tr -d ' ') IPs"
else
    log "Warning: no IPs resolved for $PF_TABLE."
fi
