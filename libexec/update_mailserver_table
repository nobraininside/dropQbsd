#!/bin/ksh
# ==========================================================
#  dropQbsd -- update_mailserver_table
#
#  Resolves mail server hostnames via userweb and populates
#  the <mailserver> PF table. Root never touches the network
#  directly -- DNS resolution is delegated to userweb.
#
#  Hostnames read from /etc/dropQbsd/local.conf,
#  section [mailserver], key "hosts".
#
#  Path: /opt/dropQbsd/libexec/update_mailserver_table
#  Permissions: chmod 700, root:wheel
# ==========================================================

LOCAL_CONF="/etc/dropQbsd/local.conf"
PF_TABLE="mailserver"

HOSTS=$(grep -A3 'mailserver' "$LOCAL_CONF" | grep 'hosts' | head -1 | sed 's/.*= *//')

if [ -z "$HOSTS" ]; then
    echo "Error: no hosts found in $LOCAL_CONF [mailserver] section." >&2
    exit 1
fi

RESOLVED=""
for host in $HOSTS; do
    result=$(su -l userweb -c "host $host 2>/dev/null" | sed -n 's/.* has address //p' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
    RESOLVED="$RESOLVED $result"
done

RESOLVED=$(echo "$RESOLVED" | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)

if [ -n "$RESOLVED" ]; then
    echo "$RESOLVED" | pfctl -t "$PF_TABLE" -T replace -f -
    logger -t dropQbsd "mailserver table updated: $(echo "$RESOLVED" | wc -l | tr -d ' ') IPs"
else
    echo "Warning: no IPs resolved." >&2
fi

